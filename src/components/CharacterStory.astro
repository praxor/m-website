---
import { marked } from "marked";
import type { CharacterChapter } from "../data/characters";

interface Props {
  chapters: CharacterChapter[];
  characterSlug: string;
}

const { chapters, characterSlug } = Astro.props as Props;
const formatChapterDate = (date: string) => {
  const parsed = new Date(`${date}T00:00:00Z`);
  return Number.isNaN(parsed.valueOf())
    ? "--/--"
    : new Intl.DateTimeFormat("en-US", {
        month: "2-digit",
        day: "2-digit",
        timeZone: "UTC",
      }).format(parsed);
};
---

<section
  class="character-story"
  aria-labelledby="character-story-title"
  data-character-slug={characterSlug}
>
  <h2 id="character-story-title">story</h2>
  <div class="story-chapters">
    {chapters.map((chapter) => (
      <button
        class="story-entry"
        type="button"
        data-story-open={chapter.number}
        aria-label={`Chapter ${chapter.number}: ${chapter.title}, ${formatChapterDate(chapter.date)}`}
      >
        <span class="story-entry-number">CH{chapter.number}</span>
        <span class="story-entry-divider" aria-hidden="true">
          ·
        </span>
        <span class="story-entry-title" title={chapter.title}>
          {chapter.title}
        </span>
        <span class="story-entry-date-divider" aria-hidden="true">
          |
        </span>
        <time datetime={chapter.date}>{formatChapterDate(chapter.date)}</time>
      </button>
    ))}
  </div>
  {chapters.map((chapter) => (
    <template data-story-chapter={chapter.number}>
      <div class="chapter-content" set:html={marked.parse(chapter.content)} />
    </template>
  ))}
  <dialog
    class="story-dialog"
    data-story-dialog
    aria-labelledby="story-dialog-title"
  >
    <div class="story-dialog-panel">
      <header class="story-dialog-heading">
        <div>
          <p class="story-dialog-number" data-story-dialog-number></p>
          <h3 id="story-dialog-title" data-story-dialog-title></h3>
        </div>
        <button
          class="story-dialog-close"
          type="button"
          data-story-close
          aria-label="Close chapter"
        >
          ×
        </button>
      </header>
      <div class="story-dialog-content" data-story-dialog-content></div>
    </div>
  </dialog>
</section>

<style>
  /* Component styles: character story */
  .character-story {
    box-sizing: border-box;
    min-width: 0;
    padding: 0.7rem;
    border: 1px solid var(--muted-border);
    border-radius: 2px;
  }
  .character-story > h2 {
    margin: 0 0 0.45rem;
    color: var(--accent);
    font-size: 0.9rem;
    text-transform: lowercase;
  }
  .story-chapters {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .story-entry {
    display: flex;
    align-items: center;
    gap: 7px;
    width: 100%;
    min-width: 0;
    min-height: 34px;
    padding: 5px 7px;
    border: 1px solid transparent;
    border-radius: 3px;
    background: transparent;
    color: var(--text);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .story-entry:hover,
  .story-entry:focus-visible {
    border-color: var(--muted-border);
    background: var(--accent-10);
  }
  .story-entry:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .story-entry-number {
    flex: 0 0 auto;
    color: var(--accent);
    font-size: 0.68rem;
    font-weight: 800;
  }
  .story-entry-divider {
    flex: 0 0 auto;
    color: var(--muted);
  }
  .story-entry-title {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    color: var(--text);
    font-size: 0.78rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .story-entry-date-divider {
    flex: 0 0 auto;
    color: var(--muted);
    font-size: 0.7rem;
  }
  .story-entry time {
    flex: 0 0 auto;
    color: var(--muted);
    font-size: 0.66rem;
    font-variant-numeric: tabular-nums;
  }
  .story-dialog {
    box-sizing: border-box;
    width: min(560px, calc(100vw - 28px));
    max-width: none;
    max-height: min(78dvh, 720px);
    padding: 0;
    border: 1px solid var(--muted-border);
    border-radius: 5px;
    background: var(--card);
    color: var(--text);
    box-shadow: 0 18px 54px var(--shadow-strong);
  }
  .story-dialog::backdrop {
    background: rgba(0, 0, 0, 0.68);
    backdrop-filter: blur(2px);
  }
  .story-dialog[open] {
    animation: story-dialog-in 0.18s ease-out both;
  }
  @keyframes story-dialog-in {
    from {
      opacity: 0;
      transform: translateY(6px) scale(0.99);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .story-dialog-panel {
    max-height: inherit;
    overflow-y: auto;
    padding: 16px;
  }
  .story-dialog-heading {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--muted-border);
  }
  .story-dialog-number {
    margin: 0 0 3px;
    color: var(--accent);
    font-size: 0.67rem;
    font-weight: 800;
  }
  .story-dialog-heading h3 {
    margin: 0;
    color: var(--text);
    font-size: 1rem;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }
  .story-dialog-close {
    flex: 0 0 30px;
    width: 30px;
    height: 30px;
    border: 1px solid var(--muted-border);
    border-radius: 50%;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 1.15rem;
    cursor: pointer;
  }
  .story-dialog-close:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .story-dialog-content {
    padding-top: 12px;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }
  .chapter-content :global(p) {
    margin: 0 0 0.6rem;
  }
  .chapter-content :global(p:last-child) {
    margin-bottom: 0;
  }
  .chapter-content :global(ul),
  .chapter-content :global(ol) {
    padding-left: 1.1rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .story-dialog[open] {
      animation: none;
    }
  }
</style>

<script>
  import { recordChapterView } from "../scripts/site-state";

  const initializeCharacterStory = () => {
    document
      .querySelectorAll<HTMLElement>(".character-story")
      .forEach((story) => {
        if (story.dataset.initialized === "true") return;
        story.dataset.initialized = "true";
        const dialog = story.querySelector<HTMLDialogElement>(
          "[data-story-dialog]",
        );
        const title = story.querySelector<HTMLElement>(
          "[data-story-dialog-title]",
        );
        const number = story.querySelector<HTMLElement>(
          "[data-story-dialog-number]",
        );
        const content = story.querySelector<HTMLElement>(
          "[data-story-dialog-content]",
        );
        const close =
          story.querySelector<HTMLButtonElement>("[data-story-close]");
        if (!dialog || !title || !number || !content || !close) return;

        story
          .querySelectorAll<HTMLButtonElement>("[data-story-open]")
          .forEach((button) => {
            button.addEventListener("click", () => {
              const chapterNumber = button.dataset.storyOpen || "";
              const characterSlug = story.dataset.characterSlug || "";
              const template = story.querySelector<HTMLTemplateElement>(
                `template[data-story-chapter="${chapterNumber}"]`,
              );
              if (!template) return;
              recordChapterView(characterSlug, Number(chapterNumber));
              number.textContent = `CH${chapterNumber}`;
              title.textContent =
                button.querySelector<HTMLElement>(".story-entry-title")
                  ?.textContent || "";
              content.replaceChildren(template.content.cloneNode(true));
              dialog.showModal();
              close.focus();
            });
          });
        close.addEventListener("click", () => dialog.close());
        dialog.addEventListener("click", (event) => {
          if (event.target === dialog) dialog.close();
        });
      });
  };

  initializeCharacterStory();
  document.addEventListener("astro:page-load", initializeCharacterStory);
</script>
