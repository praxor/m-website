---
import Icon from "./Icon.astro";

interface Props {
  type: "update" | "major" | "post";
}

const { type } = Astro.props;
const name = type === "update" ? "tool" : type === "major" ? "star" : "file-text";
---

<Icon name={name} class="post-type-svg" aria-hidden="true" focusable="false" />

<style is:global>
  /* Component styles: post type icon */
  .post-type-svg {
    display: block;
    width: 15px;
    height: 15px;
    stroke-width: 1.65;
  }
</style>
