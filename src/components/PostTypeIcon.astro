---
interface Props {
  type: 'update' | 'post';
}

const { type } = Astro.props;
---

<svg class="post-type-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {type === 'update' ? (
    <path d="M20.8 6.2a5.6 5.6 0 0 1-7.2 5.3l-6.2 6.2a2 2 0 1 1-2.8-2.8l6.2-6.2a5.6 5.6 0 0 1 7.1-7.2l-3.3 3.3 2.9 2.9 3.3-3.3z" />
  ) : (
    <g>
      <path d="M6.5 3.5h7l4 4v13h-11z" />
      <path d="M13.5 3.5v4h4M9.5 11.5h5M9.5 15h5M9.5 18.5h5" />
    </g>
  )}
</svg>

<style>
  .post-type-svg{display:block;width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:1.65;stroke-linecap:round;stroke-linejoin:round}
</style>