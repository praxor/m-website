---
import { characters } from '../data/characters';
const base = import.meta.env.BASE_URL;
---
<header class="site-header" role="banner" data-persisted-shell transition:persist transition:animate="none">
  <div class="container">
    <a class="logo" href={base}>
      <img src="https://praxor.de/media/oraxor.png" alt="oraxor the cat" width="36" height="36" decoding="async" />
    </a>
    <nav class="nav" role="navigation" aria-label="Main">
      <a href={`${base}art`}>art</a>
      <div class="character-menu">
        <a class="character-menu-link" href={`${base}characters`}>characters <span class="character-chevron" aria-hidden="true"></span></a>
        <div class="character-menu-panel">
          {characters.map((character) => <a href={`${base}characters/${character.slug}`}>{character.name}</a>)}
        </div>
      </div>
      <a href={`${base}plinko`}>plinko</a>
      <a href={`${base}music`}>music</a>
      <a href={`${base}about`}>about</a>
      <a class="cult-link" href={`${base}cult`}>cult</a>
    </nav>
    <div class="actions">
      <button id="contact-btn" class="cta" aria-haspopup="dialog" aria-expanded="false">contact</button>
      <div class="header-socials">
        <a href="https://open.spotify.com/artist/5qjpeOAlOrY6kilCDZzYoz" target="_blank" rel="noopener" aria-label="Spotify" title="open praxor on spotify" class="social-btn">
