      </a>
      <a href="https://x.com/praxorf" target="_blank" rel="noopener" aria-label="Twitter" title="open praxor on x" class="social-btn">
        <svg role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><title>x</title><path d="M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z"/></svg>
      </a>
    </div>
  </nav>
  <style>
    .site-header{position:sticky;top:0;z-index:40;background:var(--card);border-bottom:1px solid var(--muted-border)}
    .site-header .container{max-width:1100px;margin:0 auto;padding:10px 20px;display:flex;align-items:center;gap:14px}
    .logo{display:inline-block;text-decoration:none}
    .logo img{height:32px;width:auto;border-radius:0;display:block}
    .logo.secret-ready img{animation:secret-cat-spin .32s linear infinite}
    @keyframes secret-cat-spin{to{transform:rotate(360deg)}}
    .nav{display:flex;gap:12px;margin-left:6px}
    .nav a{color:var(--muted);text-decoration:none;padding:5px 7px;border-radius:8px;font-weight:600}
    .nav a:hover{background:rgba(255,255,255,0.02);color:var(--text)}
    .character-menu{position:relative;display:flex;align-items:center}
    .character-chevron{display:inline-block;width:6px;height:6px;margin:0 0 3px 6px;border-right:1.5px solid currentColor;border-bottom:1.5px solid currentColor;transform:rotate(45deg);transition:transform .18s ease}
    .character-menu:hover .character-chevron,.character-menu:focus-within .character-chevron{transform:rotate(225deg)}
    .character-menu-panel{position:absolute;top:calc(100% + 10px);left:0;min-width:170px;padding:6px;background:var(--card);border:1px solid var(--muted-border);border-radius:8px;box-shadow:0 16px 34px rgba(4,2,10,.4);opacity:0;visibility:hidden;transform:translateY(-6px);transition:opacity .18s ease,transform .18s ease,visibility .18s ease}
    .character-menu:hover .character-menu-panel,.character-menu:focus-within .character-menu-panel{opacity:1;visibility:visible;transform:translateY(0)}
    .character-menu-panel a{display:block;white-space:nowrap}
    .cult-link{color:var(--card)!important}
    .actions{margin-left:auto;display:flex;align-items:center;gap:6px}
    .menu-toggle{display:none;width:38px;height:34px;padding:0;background:transparent;border:1px solid transparent;border-radius:7px;color:var(--muted);line-height:1;cursor:pointer}
    .menu-toggle:hover,.menu-toggle:focus-visible{background:var(--accent-10);color:var(--text)}
    .menu-icon{position:relative;display:block;width:18px;height:14px;margin:auto}
    .menu-icon i{position:absolute;left:0;width:18px;height:2px;border-radius:2px;background:currentColor;transition:transform .24s ease,opacity .18s ease,top .24s ease}
    .menu-icon i:nth-child(1){top:0}.menu-icon i:nth-child(2){top:6px}.menu-icon i:nth-child(3){top:12px}
    .menu-toggle[aria-expanded="true"] .menu-icon i:nth-child(1){top:6px;transform:rotate(45deg)}
    .menu-toggle[aria-expanded="true"] .menu-icon i:nth-child(2){opacity:0;transform:scaleX(0)}
    .menu-toggle[aria-expanded="true"] .menu-icon i:nth-child(3){top:6px;transform:rotate(-45deg)}
    .mobile-nav{display:none}

    @media (max-width:780px){
      .nav{display:none}
      .menu-toggle{display:inline-block;margin-left:auto}
      .actions{display:none}
      .site-header .container{padding:8px 12px}
      .mobile-nav{position:absolute;top:100%;left:0;right:0;box-sizing:border-box;display:flex;flex-direction:column;gap:2px;max-height:0;padding:0 12px;background:var(--card);border-top:1px solid transparent;opacity:0;overflow:hidden;transform:translateY(-8px);transition:max-height .32s ease,padding .32s ease,opacity .24s ease,transform .32s ease,border-color .32s ease;visibility:hidden}
      .mobile-nav.open{max-height:520px;padding:8px 12px 4px;border-top-color:var(--muted-border);opacity:1;transform:translateY(0);visibility:visible}
      .mobile-nav a{display:block;color:var(--muted);text-decoration:none;padding:11px 10px;border-radius:8px;font-weight:600}
      .mobile-nav a:hover,.mobile-nav a:focus{background:rgba(255,255,255,0.04);color:var(--text)}
      .mobile-nav .cult-link{color:var(--card)!important}
      .mobile-character-row{display:flex;align-items:center;gap:4px}
      .mobile-character-row>a{flex:1}
      .mobile-character-toggle{width:38px;height:38px;border:0;border-radius:7px;background:transparent;color:var(--muted);font:inherit;font-size:1rem;cursor:pointer;transition:background .18s ease,transform .24s ease}
      .mobile-character-toggle:hover,.mobile-character-toggle:focus-visible{background:var(--accent-10);color:var(--text)}
      .mobile-character-toggle[aria-expanded="true"]{transform:rotate(180deg)}
      .mobile-character-links{max-height:0;overflow:hidden;opacity:0;transition:max-height .28s ease,opacity .2s ease}
      .mobile-character-links.open{max-height:180px;opacity:1}
      .mobile-character-links a{padding:8px 20px;font-size:.92rem}
      .mobile-socials{display:flex;align-items:center;justify-content:center;gap:4px;padding:5px 4px 0;border-top:1px solid var(--muted-border);margin-top:2px}
      .mobile-socials .social-btn{display:flex;align-items:center;justify-content:center;width:38px;height:34px;padding:0;font-size:16px}
    }
    @media (max-width:780px){.character-menu{display:none}}
  </style>

  <div id="contact-panel" class="contact-panel" role="dialog" aria-modal="true" aria-hidden="true">
    <div class="contact-overlay" tabindex="-1"></div>
    <div class="contact-inner" role="document">
      <button id="contact-close" class="contact-close" aria-label="Close contact panel">✕</button>
      <div class="modal-top">
        <div class="confetti" aria-hidden="true">
          <span class="piece piece-1"></span>
          <span class="piece piece-2"></span>
          <span class="piece piece-3"></span>
          <span class="piece piece-4"></span>
          <span class="piece piece-5"></span>
          <span class="piece piece-6"></span>
          <span class="piece piece-7"></span>
          <span class="piece piece-8"></span>
        </div>
        <img class="modal-cat" src="https://praxor.de/media/oraxor.png" alt="oraxor the cat" />
      </div>
      <h2 class="modal-title">contact</h2>
      <p class="modal-lead"> <em>
        email: <a href="mailto:admin@praxor.de">admin@praxor.de</a><br>
        discord: @<strong>trapstars</strong><br>
      </em></p>
    </div>
  </div>

  <style>
    .contact-panel{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;z-index:60;pointer-events:none;opacity:0;transition:opacity .28s ease}
    .contact-panel .contact-overlay{position:absolute;inset:0;background:rgba(6,4,18,0.6);backdrop-filter:blur(0px);-webkit-backdrop-filter:blur(0px);opacity:0;transition:backdrop-filter .36s ease, opacity .28s ease}
    .contact-panel .contact-inner{position:relative;z-index:2;max-width:420px;width:calc(100% - 40px);background:var(--card);border:1px solid var(--muted-border);padding:18px;border-radius:12px;box-shadow:0 20px 60px rgba(4,2,10,0.6);transform:translateY(8px) scale(.98);opacity:0;transition:transform .36s cubic-bezier(.2,.9,.2,1),opacity .28s ease}
    .contact-inner::before{content:"";position:absolute;inset:0;border-radius:12px;padding:1px;background:linear-gradient(90deg, rgba(104,34,179,0.18), rgba(104,34,179,0.06));pointer-events:none}
    .modal-top{position:absolute;left:50%;top:-36px;width:72px;height:72px;display:flex;align-items:center;justify-content:center;pointer-events:none;z-index:2}
    .modal-top .confetti{position:absolute;left:50%;top:50%;transform:translate(-50%,-10%);width:220px;height:140px;pointer-events:none;z-index:1}
    .modal-top .confetti .piece{position:absolute;width:10px;height:10px;border-radius:2px;opacity:0;transform:translate(0,0) rotate(0deg);}
    .modal-top .confetti .piece-1{left:50%;top:50%;--x:-80px;--y:-120px;background:#ff5e7e;--d:0s}
    .modal-top .confetti .piece-2{left:50%;top:50%;--x:-40px;--y:-110px;background:#ffb470;--d:0s}
    .modal-top .confetti .piece-3{left:50%;top:50%;--x:0px;--y:-120px;background:#ffd36b;--d:0s}
    .modal-top .confetti .piece-4{left:50%;top:50%;--x:40px;--y:-110px;background:#7ee4a3;--d:0s}
    .modal-top .confetti .piece-5{left:50%;top:50%;--x:80px;--y:-100px;background:#7ec9ff;--d:0s}
    .modal-top .confetti .piece-6{left:50%;top:50%;--x:-60px;--y:-70px;background:#c58cff;--d:0s}
    .modal-top .confetti .piece-7{left:50%;top:50%;--x:20px;--y:-60px;background:#ff8fcf;--d:0s}
    .modal-top .confetti .piece-8{left:50%;top:50%;--x:60px;--y:-70px;background:#ffd2a6;--d:0s}

    .modal-cat{position:relative;height:72px;width:72px;border-radius:0;object-fit:cover;display:block;opacity:1;will-change:transform,opacity;transform-origin:center}

    @keyframes cat-slide-in {
      from { transform: translateX(-120vw) translateY(0) scale(.9); opacity:0 }
      to { transform: translateX(-50%) translateY(0) scale(1); opacity:1 }
    }

    .contact-panel.open .modal-top{animation:cat-slide-in .9s cubic-bezier(.16,.8,.2,1) forwards; animation-play-state:running}

    @keyframes confetti-throw {
      from { opacity:1; transform: translate(0,0) rotate(0deg) scale(1) }
      to { opacity:0; transform: translate(var(--x), var(--y)) rotate(720deg) scale(.9) }
    }
    .contact-panel.open .modal-top .confetti .piece{animation:confetti-throw .9s cubic-bezier(.15,.8,.2,1) forwards; animation-delay: calc(var(--d) + 1s); animation-play-state:running}

    .modal-title{margin:8px 0 6px;color:var(--accent);text-align:center;font-size:1.4rem;padding-top:10px}

    @keyframes cat-explode {
      0% { opacity:1; transform:rotate(0deg) scale(1) }
      50% { transform:rotate(45deg) scale(.96) }
      100% { opacity:0; transform:rotate(1080deg) scale(.6) }
    }
    .contact-panel.closing .modal-cat{animation:cat-explode 3s cubic-bezier(.2,.9,.2,1) forwards; animation-play-state:running}

    @keyframes top-fall {
      0% { transform:translate3d(-50%,0,0) }
      100% { transform:translate3d(-50%,120vh,0) }
    }
    .contact-panel.closing .modal-top{animation:top-fall 3s ease-in forwards; animation-play-state:running}

    @keyframes confetti-explode {
      from { opacity:1; transform: translate(0,0) rotate(0deg) scale(1) }
      to { opacity:0; transform: translate(calc(var(--x) * 1.6), calc(var(--y) * 1.6)) rotate(1080deg) scale(.9) }
    }
    .contact-panel.closing .modal-top .confetti .piece{animation: none !important; opacity:0 !important; transform:none !important}
    .modal-lead{margin:0 0 8px;color:var(--muted);font-style:italic;text-align:center;opacity:1}
    .contact-panel.open{pointer-events:auto;opacity:1}
    .contact-panel.open .contact-overlay{backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);opacity:1}
    .contact-panel.open .contact-inner{transform:translateY(0) scale(1);opacity:1}
    .contact-close{position:absolute;right:14px;top:12px;background:transparent;border:0;color:var(--muted);font-size:1.1rem}
    .contact-panel h3{margin:6px 0 8px;color:var(--accent)}
    .contact-panel a{color:var(--accent)}
  </style>

  <script>
    (function(){
      const sizeSocialIcons = function(){
        document.querySelectorAll<SVGElement>('.social-btn svg').forEach((icon)=>{
          icon.setAttribute('width','20');
          icon.setAttribute('height','20');
        });
      };
      sizeSocialIcons();
      document.addEventListener('astro:page-load', sizeSocialIcons);
      const logo = document.querySelector<HTMLAnchorElement>('.logo');
      const cultUrl = new URL('cult', document.baseURI).href;
      let secretLogoTimer: number | undefined;
      let secretLogoReady = false;
      let rumbleContext: AudioContext | undefined;
      let rumbleGain: GainNode | undefined;
      let rumbleOscillators: OscillatorNode[] = [];
      let rumbleNoiseSource: AudioBufferSourceNode | undefined;
      let rumbleActive = false;
      let shakeFrame = 0;
      let shakeStartedAt = 0;
      let shakeX = 0;
      let shakeY = 0;
      let shakeTargetX = 0;
      let shakeTargetY = 0;
      let nextShakeTarget = 0;
      const stopRumble = function(){
        rumbleActive = false;
        if (rumbleGain) {
          rumbleGain.gain.cancelScheduledValues(rumbleGain.context.currentTime);
          rumbleGain.gain.setTargetAtTime(0.0001, rumbleGain.context.currentTime, .03);
        }
        if (rumbleNoiseSource) rumbleNoiseSource.stop();
        rumbleNoiseSource = undefined;
        rumbleOscillators.forEach((oscillator) => oscillator.stop());
        rumbleOscillators = [];
        if (rumbleContext) void rumbleContext.close();
        rumbleContext = undefined;
        rumbleGain = undefined;
      };
      const startRumble = async function(){
        if (rumbleActive) return;
        rumbleActive = true;
        rumbleContext = new AudioContext();
        await rumbleContext.resume();
        if (!rumbleActive || !rumbleContext) return;
        rumbleGain = rumbleContext.createGain();
        rumbleGain.gain.value = 0.0001;
        rumbleGain.connect(rumbleContext.destination);
        const noiseBuffer = rumbleContext.createBuffer(1, rumbleContext.sampleRate * 2, rumbleContext.sampleRate);
        const noiseData = noiseBuffer.getChannelData(0);
        for (let index = 0; index < noiseData.length; index += 1) noiseData[index] = Math.random() * 2 - 1;
        rumbleNoiseSource = rumbleContext.createBufferSource();
        rumbleNoiseSource.buffer = noiseBuffer;
        rumbleNoiseSource.loop = true;
        const rumbleFilter = rumbleContext.createBiquadFilter();
        rumbleFilter.type = 'lowpass';
        rumbleFilter.frequency.value = 150;
        rumbleFilter.Q.value = .7;
        rumbleNoiseSource.connect(rumbleFilter);
        rumbleFilter.connect(rumbleGain);
        rumbleNoiseSource.start();
        rumbleOscillators = [28, 36].map((frequency, index) => {
          const oscillator = rumbleContext!.createOscillator();
          oscillator.type = index === 0 ? 'sine' : 'triangle';
          oscillator.frequency.value = frequency;
          oscillator.connect(rumbleGain!);
          oscillator.start();
          return oscillator;
        });
        rumbleGain.gain.exponentialRampToValueAtTime(.035, rumbleContext.currentTime + .12);
      };
      const rampSecretShake = function(now: number){
        if (!secretLogoReady || !logo) return;
        const intensity = Math.min(1, (now - shakeStartedAt) / 1700);
        const distance = 3 + intensity * 15;
        const speed = .06 - intensity * .042;
        if (now >= nextShakeTarget) {
          shakeTargetX = (Math.random() * 2 - 1) * distance;
          shakeTargetY = (Math.random() * 2 - 1) * distance * .45;
          nextShakeTarget = now + speed * 1000;
        }
        shakeX += (shakeTargetX - shakeX) * .35;
        shakeY += (shakeTargetY - shakeY) * .35;
        logo.style.transform = `translate(${shakeX}px,${shakeY}px)`;
        shakeFrame = window.requestAnimationFrame(rampSecretShake);
      };
      const cancelSecretLogo = function(){
        if (secretLogoTimer) window.clearTimeout(secretLogoTimer);
        secretLogoTimer = undefined;
        if (shakeFrame) window.cancelAnimationFrame(shakeFrame);
        shakeFrame = 0;
        shakeX = 0;
        shakeY = 0;
        shakeTargetX = 0;
        shakeTargetY = 0;
        nextShakeTarget = 0;
        logo?.style.removeProperty('transform');
        logo?.classList.remove('secret-ready');
        stopRumble();
      };
      logo?.addEventListener('pointerdown', function(){
        if (!window.matchMedia('(max-width: 780px)').matches) return;
        secretLogoReady = false;
        secretLogoTimer = window.setTimeout(() => {
          secretLogoReady = true;
          logo?.classList.add('secret-ready');
          shakeStartedAt = performance.now();
          shakeFrame = window.requestAnimationFrame(rampSecretShake);
          void startRumble();
        }, 700);
      });
      logo?.addEventListener('pointerup', function(event){
        if (!secretLogoReady) {
          cancelSecretLogo();
          return;
        }
        event.preventDefault();
        cancelSecretLogo();
        secretLogoReady = false;
        if (window.matchMedia('(max-width: 780px)').matches) {
          window.location.href = cultUrl;
        }
      });
      logo?.addEventListener('pointercancel', cancelSecretLogo);
      logo?.addEventListener('pointerleave', cancelSecretLogo);
      const setupHeaderInteractions = function(){
        const btn = document.getElementById('contact-btn') as HTMLButtonElement;
        const menuToggle = document.getElementById('menu-toggle');
        const mobileNav = document.getElementById('mobile-nav');
        const mobileCharacterToggle = document.querySelector<HTMLButtonElement>('.mobile-character-toggle');
        const mobileCharacterLinks = document.getElementById('mobile-character-links');
        const panel = document.getElementById('contact-panel') as HTMLElement;
        const close = document.getElementById('contact-close') as HTMLButtonElement | null;
        if (!btn || !panel || btn.dataset.bound === 'true') return;
        btn.dataset.bound = 'true';
        const closeMobileNav = function(){
        if (!menuToggle || !mobileNav) return;
        mobileNav.classList.remove('open');
        menuToggle.setAttribute('aria-expanded','false');
        mobileCharacterLinks?.classList.remove('open');
        mobileCharacterToggle?.setAttribute('aria-expanded','false');
        };
        if (menuToggle && mobileNav) {
          menuToggle.addEventListener('click', function(){
            const isOpen = mobileNav.classList.toggle('open');
            menuToggle.setAttribute('aria-expanded', String(isOpen));
          });
          mobileNav.querySelectorAll('a').forEach((link)=> link.addEventListener('click', closeMobileNav));
          document.addEventListener('keydown', function(e){
            if (e.key === 'Escape') closeMobileNav();
          });
        }
        if (mobileCharacterToggle && mobileCharacterLinks) {
          mobileCharacterToggle.addEventListener('click', function(){
            const isOpen = mobileCharacterLinks.classList.toggle('open');
            mobileCharacterToggle.setAttribute('aria-expanded', String(isOpen));
          });
        }
        function openPanel(){
          panel.classList.remove('closing');
          panel.classList.add('open');
          panel.setAttribute('aria-hidden','false');
          btn.setAttribute('aria-expanded','true');
          const focusable = panel.querySelector<HTMLElement>('a, button, [tabindex], input');
          if(focusable) focusable.focus();
        }
        function closePanel(){
          if (panel.classList.contains('closing')) return;
          panel.classList.add('closing');

            const modalCat = panel.querySelector('.modal-cat');
            const finishClose = function(){
              panel.classList.remove('closing');
              panel.classList.remove('open');
              panel.setAttribute('aria-hidden','true');
              btn.setAttribute('aria-expanded','false');
              btn.focus();
            };

          if (modalCat) {
            const handler = function(e: Event){
              if (e.target !== modalCat) return;
              modalCat.removeEventListener('animationend', handler);
              finishClose();
            };
            modalCat.addEventListener('animationend', handler);
          } else {
            finishClose();
          }
        }
        btn.addEventListener('click', function(){
          const open = panel.classList.contains('open');
          if(open) closePanel(); else openPanel();
        });
        if (close) close.addEventListener('click', closePanel);
        const overlay = panel.querySelector('.contact-overlay');
        if (overlay) overlay.addEventListener('click', closePanel);
        document.addEventListener('keydown', (e)=>{ if(e.key==='Escape') closePanel(); });
      };
      setupHeaderInteractions();
      document.addEventListener('astro:page-load', setupHeaderInteractions);
    })();
  </script>
  <script>
    if (typeof window !== 'undefined') {
      window.addEventListener('load', function() {
        document.documentElement.classList.add('is-loaded');
      });
    }
  </script>
</header>
