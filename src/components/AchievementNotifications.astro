---
import ThemePreview from "./ThemePreview.astro";
---

<div
  class="sm-reward-stack"
  data-achievement-rewards
  aria-live="polite"
  aria-relevant="additions text"
></div>
<ThemePreview />

<style is:global>
  /* Component styles: achievement notifications */
  .sm-reward-stack {
    position: fixed;
    top: calc(48px + env(safe-area-inset-top));
    right: 10px;
    z-index: 310;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    box-sizing: border-box;
    max-height: calc(100dvh - 64px - env(safe-area-inset-top));
    overflow-y: auto;
    padding: 2px;
    pointer-events: none;
    scrollbar-width: thin;
  }
  .sm-reward-toast {
    position: relative;
    isolation: isolate;
    box-sizing: border-box;
    display: flex;
    flex: 0 0 auto;
    flex-direction: column;
    gap: 9px;
    width: min(340px, calc(100vw - 20px));
    max-height: min(42dvh, 340px);
    overflow-y: auto;
    padding: 12px 12px 15px;
    border: 1px solid var(--accent);
    border-radius: 8px;
    background: var(--card);
    color: var(--text);
    box-shadow:
      0 12px 30px var(--shadow-strong),
      0 0 18px color-mix(in srgb, var(--accent) 22%, transparent);
    opacity: 0;
    pointer-events: auto;
    transform: translateY(12px) scale(0.98);
    transition:
      opacity 0.22s ease,
      transform 0.24s cubic-bezier(0.2, 0.9, 0.3, 1);
  }
  .sm-reward-toast[data-visible="true"] {
    opacity: 1;
    transform: none;
  }
  .sm-reward-toast[data-visible="false"] {
    opacity: 0;
    transform: translateY(-8px) scale(0.98);
  }
  .sm-reward-head {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .sm-reward-kicker {
    flex: 1;
    color: var(--accent);
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .sm-reward-dismiss {
    display: grid;
    place-items: center;
    flex: 0 0 28px;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 1px solid var(--muted-border);
    border-radius: 50%;
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }
  .sm-reward-dismiss:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .sm-reward-dismiss:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .sm-reward-achievement {
    font-size: 0.92rem;
    font-weight: 800;
  }
  .sm-reward-progress {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
    background: var(--accent);
    transform: scaleX(1);
    transform-origin: left center;
    pointer-events: none;
  }
  .sm-reward-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .sm-reward-item {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding-top: 8px;
    border-top: 1px solid var(--muted-border);
  }
  .sm-reward-name {
    font-size: 0.8rem;
    font-weight: 700;
  }
  .sm-reward-description {
    margin: 0;
    color: var(--muted);
    font-size: 0.74rem;
    line-height: 1.4;
  }
  .sm-reward-preview {
    margin-top: 4px;
  }
  .sm-reward-preview .sm-mini-preview {
    min-height: 92px;
    padding: 7px;
    gap: 5px;
  }
  .sm-reward-preview .sm-mini-header {
    padding-bottom: 4px;
  }
  .sm-reward-preview .sm-mini-title {
    font-size: 0.68rem;
  }
  .sm-reward-preview .sm-mini-panel {
    min-height: 16px;
  }
  .sm-reward-preview .sm-mini-nav {
    font-size: 0.4rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .sm-reward-toast {
      transition: none;
      transform: none;
    }
  }
  :root[data-reduced-motion="true"] .sm-reward-toast {
    transition: none;
    transform: none;
  }
  @media (max-width: 520px) {
    .sm-reward-stack {
      right: 8px;
      max-height: calc(64dvh - env(safe-area-inset-top));
    }
    .sm-reward-toast {
      width: min(340px, calc(100vw - 16px));
      max-height: 34dvh;
    }
  }
</style>
