    )!;
    const carouselDots = root.querySelector<HTMLElement>(
      "[data-sm-carousel-dots]",
    )!;
    const carouselPosition = root.querySelector<HTMLElement>(
      "[data-sm-carousel-position]",
    )!;
    const previousThemeButton =
      root.querySelector<HTMLButtonElement>("[data-sm-previous]")!;
    const nextThemeButton =
      root.querySelector<HTMLButtonElement>("[data-sm-next]")!;
    const previewTemplate = root.querySelector<HTMLTemplateElement>(
      "[data-sm-theme-preview-template]",
    )!;
    const infoView = root.querySelector<HTMLElement>("#sm-view-info")!;
    const settingsSubtabs = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-settings-subtab]"),
    );
    const settingsFunView =
      root.querySelector<HTMLElement>("#sm-settings-fun")!;
    const settingsAccessibilityView = root.querySelector<HTMLElement>(
      "#sm-settings-accessibility",
    )!;
    const forceInput = root.querySelector<HTMLInputElement>(
      '[data-setting="forceTheme"]',
    )!;
    const motionInput = root.querySelector<HTMLInputElement>(
      '[data-setting="reducedMotion"]',
    )!;
    const plinkoExtremeInput = root.querySelector<HTMLInputElement>(
      '[data-setting="plinkoExtremeMode"]',
    )!;
    const list = root.querySelector<HTMLElement>("[data-sm-achievements]")!;
    const achievementTabs = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-achievement-category]"),
    );
    const summary = root.querySelector<HTMLElement>("[data-sm-summary]")!;
    const achievementsView = root.querySelector<HTMLElement>(
      "#sm-view-achievements",
    )!;
    const dangerZone = root.querySelector<HTMLElement>(".sm-danger-zone")!;
    const confirmBox = root.querySelector<HTMLElement>("[data-sm-confirm]")!;
    const resetButton =
      root.querySelector<HTMLButtonElement>("[data-sm-reset]")!;
    const confirmCloseButton = root.querySelector<HTMLButtonElement>(
      "[data-sm-confirm-close]",
    )!;
    const confirmButton = root.querySelector<HTMLButtonElement>(
      "[data-sm-confirm-btn]",
    )!;
    const infoPraxor =
      root.querySelector<HTMLImageElement>("[data-info-praxor]")!;
    const infoStats = root.querySelector<HTMLElement>("[data-info-stats]")!;
    const infoStage = root.querySelector<HTMLElement>("[data-info-stage]")!;
    const CAT_BOUNCE_MS = 1050;
    const CAT_FLIGHT_MS = 730;
    let catMotionReduced = prefersReducedMotion();
    let catMotionFrame = 0;
    let catBounceStartedAt = 0;
    let catBounceActive = false;
    const catMotionLifetime = new AbortController();
    let catMotionObserver: MutationObserver | undefined;
    const stopCatBounce = () => {
      if (catMotionFrame) window.cancelAnimationFrame(catMotionFrame);
      catMotionFrame = 0;
      catBounceActive = false;
      infoPraxor.style.removeProperty("transform");
    };
    const smoothstep = (value: number) => value * value * (3 - 2 * value);
    const updateCatBounce = (now: number) => {
      catMotionFrame = 0;
      if (!root.isConnected) {
        stopCatBounce();
        catMotionObserver?.disconnect();
        catMotionLifetime.abort();
        return;
      }
      if (!catBounceActive || catMotionReduced || overlay.dataset.open !== "true") {
        stopCatBounce();
        return;
      }
      if (document.hidden) return;

      const elapsed = now - catBounceStartedAt;
      if (elapsed >= CAT_BOUNCE_MS) {
        stopCatBounce();
        return;
      }

      const stageHeight = infoStage.clientHeight;
      const catHeight = infoPraxor.offsetHeight;
      const availableLift = Math.max(0, (stageHeight - catHeight) / 2 - 4);
      const jumpHeight = Math.min(catHeight * 2.5, availableLift);
      let verticalOffset = 0;
      let rotation = 0;
      let scaleX = 1;
      let scaleY = 1;

      if (elapsed < CAT_FLIGHT_MS) {
        const anticipationMs = 70;
        const anticipation = elapsed < anticipationMs
          ? Math.sin((elapsed / anticipationMs) * Math.PI)
          : 0;
        const flightProgress = Math.max(
          0,
          (elapsed - anticipationMs) / (CAT_FLIGHT_MS - anticipationMs),
        );
        const ascentPortion = 0.4;
        const arc = elapsed < anticipationMs
          ? 0
          : flightProgress < ascentPortion
            ? smoothstep(flightProgress / ascentPortion)
            : 1 - smoothstep((flightProgress - ascentPortion) / (1 - ascentPortion));
        verticalOffset = -jumpHeight * arc;
        scaleX += anticipation * 0.08 - arc * 0.025;
        scaleY -= anticipation * 0.12;
      } else {
        const landingProgress = (elapsed - CAT_FLIGHT_MS) / (CAT_BOUNCE_MS - CAT_FLIGHT_MS);
        const envelope = 1 - smoothstep(landingProgress);
        const wave = Math.sin(landingProgress * Math.PI * 8);
        const squash = Math.exp(-landingProgress * 24);
        rotation = wave * envelope * 10;
        scaleX = 1 + squash * 0.18 + Math.abs(wave) * envelope * 0.05;
        scaleY = 1 - squash * 0.22 - Math.abs(wave) * envelope * 0.08;
        verticalOffset = -Math.abs(wave) * envelope * 2;
      }

      infoPraxor.style.transform = `translate3d(0, ${verticalOffset.toFixed(3)}px, 0) rotate(${rotation.toFixed(3)}deg) scale(${scaleX.toFixed(4)}, ${scaleY.toFixed(4)})`;
      catMotionFrame = window.requestAnimationFrame(updateCatBounce);
    };
    const scheduleCatBounce = () => {
      if (catBounceActive && !document.hidden && !catMotionReduced && !catMotionFrame) {
        catMotionFrame = window.requestAnimationFrame(updateCatBounce);
      }
    };
    const startCatBounce = () => {
      stopCatBounce();
      if (catMotionReduced || document.hidden) return;
      catBounceActive = true;
      catBounceStartedAt = performance.now();
      scheduleCatBounce();
    };
    const cleanupCatBounce = () => {
      stopCatBounce();
      catMotionObserver?.disconnect();
      catMotionLifetime.abort();
    };
    document.addEventListener(
      "visibilitychange",
      () => {
        if (document.hidden) {
          if (catMotionFrame) window.cancelAnimationFrame(catMotionFrame);
          catMotionFrame = 0;
        } else scheduleCatBounce();
      },
      { signal: catMotionLifetime.signal },
    );
    window.addEventListener(
      CHANGE_EVENT,
      () => {
        catMotionReduced = prefersReducedMotion();
        if (catMotionReduced) stopCatBounce();
      },
      { signal: catMotionLifetime.signal },
    );
    catMotionObserver = new MutationObserver(() => {
      if (!root.isConnected) cleanupCatBounce();
    });
    if (root.parentElement) {
      catMotionObserver.observe(root.parentElement, { childList: true });
    }
    const settingsCatAudio = new Audio("/media/mewmewmew.wav");
    settingsCatAudio.preload = "auto";
    settingsCatAudio.volume = 0.22;
    settingsCatAudio.preservesPitch = false;
    const activateSettingsCat = () => {
      recordSettingsCatClick();
      settingsCatAudio.playbackRate = 0.94 + Math.random() * 0.12;
      settingsCatAudio.currentTime = 0;
      void settingsCatAudio.play().catch(() => undefined);
      if (!prefersReducedMotion()) {
        infoPraxor.animate(
          [
            { scale: "1 1" },
            { scale: "1.16 0.7", offset: 0.42 },
            { scale: "0.94 1.08", offset: 0.72 },
            { scale: "1 1" },
          ],
          { duration: 260, easing: "cubic-bezier(0.2, 0.8, 0.3, 1)" },
        );
      }
    };

    infoPraxor.addEventListener("click", activateSettingsCat);
    infoPraxor.addEventListener("keydown", (event) => {
      if ((event.key !== "Enter" && event.key !== " ") || event.repeat) return;
      event.preventDefault();
      activateSettingsCat();
    });

    const HOLD_DURATION_MS = 6700;
    const confirmProgress = root.querySelector<HTMLElement>(
      "[data-sm-confirm-progress]",
    )!;
    const confirmLabel = root.querySelector<HTMLElement>(
      "[data-sm-confirm-label]",
    )!;
    let holdFrame = 0;
    let holdStartedAt = 0;
    let holdKind: "pointer" | "keyboard" | null = null;
    let activePointerId: number | null = null;
    let activeKey: string | null = null;
    let resetStarted = false;
    let activeAchievementCategory = "site";

    const clearHold = () => {
      if (holdFrame) window.cancelAnimationFrame(holdFrame);
      holdFrame = 0;
      holdKind = null;
      activePointerId = null;
      activeKey = null;
      confirmBox.removeAttribute("data-holding");
      confirmProgress.style.transform = "scaleX(0)";
      confirmLabel.textContent = "Hold to Confirm";
      const panel = confirmBox.querySelector<HTMLElement>(".sm-confirm-panel")!;
      panel.style.removeProperty("--sm-shake-x");
      panel.style.removeProperty("--sm-shake-y");
      panel.style.removeProperty("--sm-shake-rotation");
    };

    const resetHold = () => {
      resetStarted = false;
      confirmButton.disabled = false;
      clearHold();
      confirmProgress.setAttribute("aria-valuenow", "0");
    };

    const completeReset = () => {
      if (resetStarted) return;
      resetStarted = true;
      if (holdFrame) window.cancelAnimationFrame(holdFrame);
      holdFrame = 0;
      holdKind = null;
      activePointerId = null;
      activeKey = null;
      confirmBox.removeAttribute("data-holding");
      confirmLabel.textContent = "Resetting...";
      confirmButton.disabled = true;
      resetAllData();
      window.location.reload();
    };

    const updateHold = (now: number) => {
      if (!holdKind) return false;
      const progress = Math.min((now - holdStartedAt) / HOLD_DURATION_MS, 1);
      confirmProgress.style.transform = `scaleX(${progress})`;
      confirmProgress.setAttribute(
        "aria-valuenow",
        String(Math.round(progress * 100)),
      );
      if (!prefersReducedMotion()) {
        const intensity = progress * progress;
        const amplitude = intensity * 14;
        const elapsed = now - holdStartedAt;
        const panel =
          confirmBox.querySelector<HTMLElement>(".sm-confirm-panel")!;
        panel.style.setProperty(
          "--sm-shake-x",
          `${Math.sin(elapsed / 24) * amplitude}px`,
        );
        panel.style.setProperty(
          "--sm-shake-y",
          `${Math.cos(elapsed / 31) * amplitude * 0.72}px`,
        );
        panel.style.setProperty(
          "--sm-shake-rotation",
          `${Math.sin(elapsed / 28) * intensity * 3.5}deg`,
        );
      }
      if (progress >= 1) {
        completeReset();
        return true;
      }
      return false;
    };

    const animateHold = (now: number) => {
      if (!holdKind) return;
      if (updateHold(now)) return;
      holdFrame = window.requestAnimationFrame(animateHold);
    };

    const startHold = (kind: "pointer" | "keyboard") => {
      if (holdKind || resetStarted) return;
      holdKind = kind;
      holdStartedAt = performance.now();
      confirmBox.dataset.holding = "true";
      confirmLabel.textContent = "Keep holding...";
      holdFrame = window.requestAnimationFrame(animateHold);
    };

    const finishHold = () => {
      if (!updateHold(performance.now())) clearHold();
    };

    const isConfirmOpen = () => confirmBox.dataset.open === "true";
    const setConfirmOpen = (open: boolean) => {
      if (open === isConfirmOpen()) return;
      confirmBox.dataset.open = String(open);
      if (open) {
        resetHold();
        confirmBox.querySelector<HTMLElement>(
          ".sm-confirm-panel",
        )!.dataset.reducedMotion = String(prefersReducedMotion());
        void confirmBox.offsetWidth;
        confirmCloseButton.focus();
      } else {
        clearHold();
        resetButton.focus();
      }
    };

    // Background layers made inert while the modal is open.
    const background = () =>
      document.querySelectorAll<HTMLElement>(
        ".page-shell, #music-player-shell",
      );
    const isOpen = () => overlay.dataset.open === "true";
    const setOpen = (open: boolean) => {
      if (open === isOpen()) return;
      if (!open) setConfirmOpen(false);
      if (open) startCatBounce();
      else stopCatBounce();
      overlay.dataset.open = String(open);
      toggle.setAttribute("aria-expanded", String(open));
      document.documentElement.classList.toggle("sm-open", open);
      background().forEach((element) => {
        element.inert = open;
      });
      if (open) {
        render();
        showTab("info");
        panel.querySelector<HTMLElement>(".sm-view:not([hidden])")!.scrollTop =
          0;
        void overlay.offsetWidth;
        tabs
          .find((tab) => tab.getAttribute("aria-selected") === "true")
          ?.focus();
      } else toggle.focus();
    };

    const animateTabPanel = (view: HTMLElement, direction: number) => {
      if (prefersReducedMotion()) return;
      view.animate(
        [
          { opacity: 0, transform: `translateX(${direction * 14}px)` },
          { opacity: 1, transform: "translateX(0)" },
        ],
        { duration: 220, easing: "cubic-bezier(0.2, 0.8, 0.2, 1)" },
      );
    };

    const showTab = (name: string, focus = false) => {
      const previousIndex = tabs.findIndex(
        (tab) => tab.getAttribute("aria-selected") === "true",
      );
      const nextIndex = tabs.findIndex((tab) => tab.dataset.tab === name);
      const changed = previousIndex >= 0 && nextIndex !== previousIndex;
      const direction = nextIndex > previousIndex ? 1 : -1;
      tabs.forEach((tab) => {
        const selected = tab.dataset.tab === name;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
        const view = root.querySelector<HTMLElement>(
          `#${tab.getAttribute("aria-controls")}`,
        )!;
        view.hidden = !selected;
        if (selected) {
          view.scrollTop = 0;
          if (changed) animateTabPanel(view, direction);
        }
        if (selected && focus) tab.focus();
      });
      if (name === "achievements") renderAchievements();
      if (name === "settings") {
        showSettingsSubtab("fun");
        renderSettings();
      }
    };

    const showSettingsSubtab = (
      name: "fun" | "accessibility",
      focus = false,
    ) => {
      const previousIndex = settingsSubtabs.findIndex(
        (tab) => tab.getAttribute("aria-selected") === "true",
      );
      const nextIndex = settingsSubtabs.findIndex(
        (tab) => tab.dataset.settingsSubtab === name,
      );
      const changed = previousIndex >= 0 && nextIndex !== previousIndex;
      settingsSubtabs.forEach((tab) => {
        const selected = tab.dataset.settingsSubtab === name;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
        const view =
          name === "fun" ? settingsFunView : settingsAccessibilityView;
        if (tab.dataset.settingsSubtab === name) {
          view.hidden = false;
          if (changed) animateTabPanel(view, nextIndex > previousIndex ? 1 : -1);
        }
        else
          (name === "fun"
            ? settingsAccessibilityView
            : settingsFunView
          ).hidden = true;
        if (selected && focus) tab.focus();
      });
    };

    const showAchievementCategory = (category: string, focus = false) => {
      const previousIndex = achievementTabs.findIndex(
        (tab) => tab.getAttribute("aria-selected") === "true",
      );
      const nextIndex = achievementTabs.findIndex(
        (tab) => tab.dataset.achievementCategory === category,
      );
      const changed = previousIndex >= 0 && nextIndex !== previousIndex;
      activeAchievementCategory = category;
      achievementTabs.forEach((tab) => {
        const selected = tab.dataset.achievementCategory === category;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
        if (selected) {
          list.setAttribute("aria-labelledby", tab.id);
          if (focus) tab.focus();
        }
      });
      renderAchievements();
      if (changed) animateTabPanel(list, nextIndex > previousIndex ? 1 : -1);
    };

    let themeKey = "";
    let activeThemeIndex = 0;
    let activeThemeMode: ThemeMode = "dark";
    let visibleThemes = themes.filter(
      (theme) => theme.mode === activeThemeMode,
    );
    let lastSelectedTheme = "";
    let carouselOffset = 0;
    let dragPointerId: number | null = null;
    let dragStartX = 0;
    let dragStartY = 0;
    let dragBaseOffset = 0;
    let dragDeltaX = 0;
    let carouselDragging = false;
    let suppressCardClickUntil = 0;

    const layoutCarousel = (focusChoice = false) => {
      const slides = Array.from(
        themeBox.querySelectorAll<HTMLElement>("[data-theme-slide]"),
      );
      if (!slides.length) return;
      activeThemeIndex = Math.max(
        0,
        Math.min(activeThemeIndex, slides.length - 1),
      );
      const activeSlide = slides[activeThemeIndex];
      const activeSlideRect = activeSlide.getBoundingClientRect();
      const viewportRect = carouselViewport.getBoundingClientRect();
      const currentTransform = getComputedStyle(themeBox).transform;
      const currentOffset =
        currentTransform === "none"
          ? 0
          : new DOMMatrixReadOnly(currentTransform).m41;
      carouselOffset =
        currentOffset +
        viewportRect.left +
        carouselViewport.clientWidth / 2 -
        (activeSlideRect.left + activeSlideRect.width / 2);
      if (prefersReducedMotion()) themeBox.style.transition = "none";
      else themeBox.style.removeProperty("transition");
      themeBox.style.transform = `translate3d(${carouselOffset}px,0,0)`;
      themeBox
        .querySelectorAll<HTMLButtonElement>("[data-theme-choice]")
        .forEach((choice, index) => {
          choice.tabIndex = index === activeThemeIndex ? 0 : -1;
        });
      carouselDots
        .querySelectorAll<HTMLButtonElement>("[data-theme-dot]")
        .forEach((dot, index) => {
          dot.setAttribute("aria-current", String(index === activeThemeIndex));
        });
      carouselPosition.textContent = `${activeThemeIndex + 1} / ${slides.length}`;
      previousThemeButton.disabled = activeThemeIndex === 0;
      nextThemeButton.disabled = activeThemeIndex === slides.length - 1;
      if (focusChoice)
        themeBox
          .querySelectorAll<HTMLButtonElement>("[data-theme-choice]")
          [activeThemeIndex].focus();
    };

    const setActiveTheme = (index: number, focusChoice = false) => {
      activeThemeIndex = Math.max(0, Math.min(index, visibleThemes.length - 1));
      layoutCarousel(focusChoice);
    };

    const renderThemes = () => {
      const selectedTheme = effectiveTheme();
      const selectionChanged = selectedTheme !== lastSelectedTheme;
      if (selectionChanged) {
        lastSelectedTheme = selectedTheme;
        const selectedDefinition = themes.find(
          (theme) => theme.id === selectedTheme,
        );
        if (selectedDefinition) activeThemeMode = selectedDefinition.mode;
      }
      visibleThemes = themes.filter((theme) => theme.mode === activeThemeMode);
      themeModeButtons.forEach((button) => {
        button.setAttribute(
          "aria-pressed",
          String(button.dataset.themeMode === activeThemeMode),
        );
      });
      if (selectionChanged) {
        const selectedIndex = visibleThemes.findIndex(
          (theme) => theme.id === selectedTheme,
        );
        if (selectedIndex >= 0) activeThemeIndex = selectedIndex;
      }

      const key = visibleThemes.map((theme) => theme.id).join();
      if (key !== themeKey) {
        themeKey = key;
        carouselDots.replaceChildren();
        const slides = visibleThemes.map((theme, index) => {
          const slide = document.createElement("div");
          slide.className = "sm-theme-slide";
          slide.dataset.themeSlide = "";
          slide.setAttribute("role", "listitem");

          const choice = document.createElement("button");
          choice.type = "button";
          choice.className = "sm-theme-choice sm-theme-profile";
          choice.dataset.siteTheme = theme.id;
          choice.dataset.themeChoice = "";
          choice.setAttribute("aria-pressed", "false");
          choice.tabIndex = -1;
          choice.addEventListener("click", () => {
            if (!isThemeAvailable(theme.id)) return;
            activeThemeIndex = index;
            updateSettings({ theme: theme.id });
          });

          const meta = document.createElement("span");
          meta.className = "sm-theme-meta";
          const name = document.createElement("strong");
          name.className = "sm-theme-name";
          name.textContent = theme.name;
          const selected = document.createElement("span");
          selected.className = "sm-theme-selected";
          selected.textContent = "Selected";
          meta.append(name, selected);

          const preview = previewTemplate.content.firstElementChild?.cloneNode(
            true,
          ) as HTMLElement;
          preview.dataset.siteTheme = theme.id;
          preview.style.setProperty("--sm-mini-swatch", theme.swatch);
          preview.querySelector<HTMLElement>(
            "[data-sm-mini-name]",
          )!.textContent = theme.name;

          const lock = document.createElement("span");
          lock.className = "sm-theme-lock";
          lock.hidden = true;
          const lockLabel = document.createElement("strong");
          lockLabel.className = "sm-theme-lock-label";
          lockLabel.innerHTML =
            '<span aria-hidden="true">\u{1F512}\uFE0E</span> LOCKED';
          const lockHelp = document.createElement("span");
          lockHelp.className = "sm-theme-lock-help";
          lock.dataset.themeLock = "";
          lock.append(lockLabel, lockHelp);
          choice.append(meta, preview, lock);
          applyThemePreviewPalette(choice, theme);
          slide.append(choice);

          const dot = document.createElement("button");
          dot.type = "button";
          dot.className = "sm-carousel-dot";
          dot.dataset.themeDot = "";
          dot.setAttribute("aria-current", "false");
          dot.addEventListener("click", () => setActiveTheme(index));
          carouselDots.append(dot);
          return slide;
        });
        themeBox.replaceChildren(...slides);
      }

      visibleThemes.forEach((theme, index) => {
        const available = isThemeAvailable(theme.id);
        const choice = themeBox.querySelectorAll<HTMLButtonElement>(
          "[data-theme-choice]",
        )[index];
        const lock = choice.querySelector<HTMLElement>("[data-theme-lock]")!;
        const dot =
          carouselDots.querySelectorAll<HTMLButtonElement>("[data-theme-dot]")[
            index
          ];
        const achievementName = theme.unlockedBy
          ? achievements[theme.unlockedBy].name
          : "";
        choice.setAttribute("aria-pressed", String(theme.id === selectedTheme));
        choice.setAttribute("aria-disabled", String(!available));
        choice.setAttribute(
          "aria-label",
          available
            ? `${theme.name} theme${theme.id === selectedTheme ? ", selected" : ""}`
            : `${theme.name} theme, locked. Unlock by completing ${achievementName}.`,
        );
        lock.hidden = available;
        lock.querySelector<HTMLElement>(".sm-theme-lock-help")!.textContent =
          `Unlock by completing "${achievementName}".`;
        dot.setAttribute(
          "aria-label",
          `Show ${theme.name} theme preview${available ? "" : ", locked"}`,
        );
      });
      layoutCarousel();
    };

    const renderSettings = () => {
      renderThemes();
      dangerZone.dataset.siteTheme = effectiveTheme();
      forceInput.checked = getSettings().forceTheme;
      motionInput.checked = prefersReducedMotion();
      plinkoExtremeInput.checked = getSettings().plinkoExtremeMode;
    };

    const renderInfoStats = () => {
      const stats = getUsageStats();
      const formatTime = (seconds: number) => {
        const total = Math.floor(seconds);
        const hours = Math.floor(total / 3600);
        const minutes = Math.floor((total % 3600) / 60);
        const remainder = total % 60;
        return hours
          ? `${hours}h ${minutes}m`
          : minutes
            ? `${minutes}m ${remainder}s`
            : `${remainder}s`;
      };
      const rows: [string, string][] = [
        ["Time on website", formatTime(stats.activeSeconds)],
        ["Time on website (Idle)", formatTime(stats.idleSeconds)],
        ["Posts clicked", stats.postsClicked.toLocaleString()],
        ["Pages visited", stats.pagesVisited.toLocaleString()],
        ["Minutes of music listened", `${(stats.musicListenedSeconds / 60).toFixed(1)} min`],
        ["Songs played", stats.songsPlayed.toLocaleString()],
        ["Times visited", stats.siteVisits.toLocaleString()],
        ["Plinko rounds played", stats.plinkoRoundsPlayed.toLocaleString()],
        ["Plinko resets", stats.plinkoResets.toLocaleString()],
        ["Plinko rounds played in PEM", stats.plinkoRoundsPlayedInPEM.toLocaleString()],
        ["Highest Plinko score", stats.highestPlinkoScore.toLocaleString()],
        ["Total Plinko score", stats.totalPlinkoScore.toLocaleString()],
        ["Favorite page", stats.favoritePage],
        ["Favorite character", stats.favoriteCharacter],
        ["Times clicked on Settings-xor", stats.settingsClicks.toLocaleString()],
        ["Cats exploded", stats.catsExploded.toLocaleString()],
        ["Times watched credits", stats.timesWatchedCredits.toLocaleString()],
      ];
      infoStats.replaceChildren(
        ...rows.map(([label, value]) => {
          const row = document.createElement("div");
          row.className = "sm-info-stat";
          const name = document.createElement("dt");
          name.textContent = label;
          const count = document.createElement("dd");
          count.textContent = value;
          row.append(name, count);
          return row;
        }),
      );
    };

    const renderAchievements = () => {
      const visible = getAchievements().filter(
        (item) => item.category === activeAchievementCategory,
      );
      summary.textContent = `${visible.filter((item) => item.unlocked).length} / ${visible.length} unlocked`;
      list.replaceChildren(
        ...visible.map((item) => {
          const li = document.createElement("li");
          li.className = `sm-ach${item.unlocked ? " is-unlocked" : ""}`;
          const icon = document.createElement("span");
          icon.className = "sm-ach-icon";
          icon.setAttribute("aria-hidden", "true");
          icon.textContent = item.unlocked ? "\u2713" : "\u{1F512}\uFE0E";
          const body = document.createElement("div");
          const name = document.createElement("span");
          name.className = "sm-ach-name";
          name.textContent = item.name;
          const desc = document.createElement("span");
          desc.className = "sm-ach-desc";
          desc.textContent =
            item.secret && !item.unlocked ? "???" : item.description;
          const hint = item.hint ? document.createElement("span") : null;
          if (hint) {
            hint.className = "sm-ach-hint";
            hint.textContent = `Hint: ${item.hint}`;
          }
          const progress = document.createElement("div");
          progress.className = "sm-ach-progress";
          const bar = document.createElement("div");
          bar.className = "sm-ach-bar";
          bar.setAttribute("role", "progressbar");
          bar.setAttribute("aria-label", `${item.name} progress`);
          bar.setAttribute("aria-valuemin", "0");
          bar.setAttribute("aria-valuemax", String(item.goal));
          bar.setAttribute("aria-valuenow", String(item.progress));
          const fill = document.createElement("i");
          fill.style.width = `${(item.progress / item.goal) * 100}%`;
          bar.append(fill);
          const count = document.createElement("span");
          const state = document.createElement("span");
          state.className = "sm-ach-state";
          state.textContent = item.unlocked ? "Unlocked" : "Locked";
          if (!item.progressVisible) {
            progress.append(state);
          } else if (!item.goalVisible) {
            count.textContent = `${item.progress} / ???${item.unit ? ` ${item.unit}` : ""}`;
            progress.append(count, state);
          } else {
            count.textContent = `${item.progress} / ${item.goal}${item.unit ? ` ${item.unit}` : ""}`;
            progress.append(bar, count, state);
          }
          body.append(name, desc);
          if (hint) body.append(hint);
          body.append(progress);
          li.append(icon, body);
          return li;
        }),
      );
    };

    const render = () => {
      renderSettings();
      renderInfoStats();
      if (!achievementsView.hidden) renderAchievements();
    };

    const finishCarouselDrag = (event: PointerEvent, cancelled = false) => {
      if (event.pointerId !== dragPointerId) return;
      const wasDragging = carouselDragging;
      const deltaX = dragDeltaX;
      window.removeEventListener("pointermove", moveCarouselPointer);
      window.removeEventListener("pointerup", endCarouselPointer);
      window.removeEventListener("pointercancel", cancelCarouselPointer);
      dragPointerId = null;
      carouselDragging = false;
      carouselViewport.removeAttribute("data-dragging");
      if (!cancelled && wasDragging) {
        suppressCardClickUntil = performance.now() + 450;
        if (Math.abs(deltaX) >= 45)
          setActiveTheme(activeThemeIndex + (deltaX < 0 ? 1 : -1));
        else layoutCarousel();
      } else {
        layoutCarousel();
      }
    };

    const moveCarouselPointer = (event: PointerEvent) => {
      if (event.pointerId !== dragPointerId) return;
      dragDeltaX = event.clientX - dragStartX;
      const deltaY = event.clientY - dragStartY;
      if (
        !carouselDragging &&
        Math.abs(dragDeltaX) > 8 &&
        Math.abs(dragDeltaX) > Math.abs(deltaY)
      ) {
        carouselDragging = true;
        carouselViewport.dataset.dragging = "true";
        themeBox.style.transition = "none";
      }
      if (carouselDragging) {
        event.preventDefault();
        themeBox.style.transform = `translate3d(${dragBaseOffset + dragDeltaX}px,0,0)`;
      }
    };

    const endCarouselPointer = (event: PointerEvent) =>
      finishCarouselDrag(event);
    const cancelCarouselPointer = (event: PointerEvent) =>
      finishCarouselDrag(event, true);

    const cancelCarouselDrag = () => {
      if (dragPointerId === null) return;
      window.removeEventListener("pointermove", moveCarouselPointer);
      window.removeEventListener("pointerup", endCarouselPointer);
      window.removeEventListener("pointercancel", cancelCarouselPointer);
      dragPointerId = null;
      carouselDragging = false;
      carouselViewport.removeAttribute("data-dragging");
      layoutCarousel();
    };

    themeModeButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const mode = button.dataset.themeMode;
        if ((mode !== "light" && mode !== "dark") || mode === activeThemeMode)
          return;
        activeThemeMode = mode;
        const selectedIndex = themes
          .filter((theme) => theme.mode === activeThemeMode)
          .findIndex((theme) => theme.id === effectiveTheme());
        activeThemeIndex = selectedIndex >= 0 ? selectedIndex : 0;
        renderThemes();
      });
    });
    previousThemeButton.addEventListener("click", () =>
      setActiveTheme(activeThemeIndex - 1),
    );
    nextThemeButton.addEventListener("click", () =>
      setActiveTheme(activeThemeIndex + 1),
    );
    carouselViewport.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
        event.preventDefault();
        setActiveTheme(
          activeThemeIndex + (event.key === "ArrowRight" ? 1 : -1),
          true,
        );
      } else if (event.key === "Home" || event.key === "End") {
        event.preventDefault();
        setActiveTheme(
          event.key === "Home" ? 0 : visibleThemes.length - 1,
          true,
        );
      }
    });
    carouselViewport.addEventListener("pointerdown", (event) => {
      if (event.pointerType === "mouse" && event.button !== 0) return;
      dragPointerId = event.pointerId;
      dragStartX = event.clientX;
      dragStartY = event.clientY;
      dragBaseOffset = carouselOffset;
      dragDeltaX = 0;
      carouselDragging = false;
      window.addEventListener("pointermove", moveCarouselPointer);
      window.addEventListener("pointerup", endCarouselPointer);
      window.addEventListener("pointercancel", cancelCarouselPointer);
    });
    carouselViewport.addEventListener(
      "click",
      (event) => {
        if (performance.now() >= suppressCardClickUntil) return;
        event.preventDefault();
        event.stopImmediatePropagation();
      },
      true,
    );
    window.addEventListener("resize", () => layoutCarousel());
    window.addEventListener("blur", cancelCarouselDrag);

    toggle.addEventListener("click", () => setOpen(!isOpen()));
    resetButton.addEventListener("click", () => setConfirmOpen(true));
    confirmCloseButton.addEventListener("click", () => setConfirmOpen(false));
    confirmBox.addEventListener("pointerdown", (event) => {
      if (event.target === confirmBox) setConfirmOpen(false);
    });
    confirmButton.addEventListener("pointerdown", (event) => {
      if (event.pointerType === "mouse" && event.button !== 0) return;
      event.preventDefault();
      if (holdKind) return;
      activePointerId = event.pointerId;
      startHold("pointer");
      try {
        confirmButton.setPointerCapture(event.pointerId);
      } catch {
        clearHold();
      }
    });
    confirmButton.addEventListener("pointerup", (event) => {
      if (holdKind !== "pointer" || event.pointerId !== activePointerId) return;
      event.preventDefault();
      finishHold();
    });
    confirmButton.addEventListener("pointercancel", () => {
      if (holdKind === "pointer") clearHold();
    });
    confirmButton.addEventListener("lostpointercapture", () => {
      if (holdKind === "pointer") clearHold();
    });
    confirmButton.addEventListener("keydown", (event) => {
      if (event.key !== "Enter" && event.code !== "Space") return;
      event.preventDefault();
      if (event.repeat || holdKind) return;
      activeKey = event.code || event.key;
      startHold("keyboard");
    });
    confirmButton.addEventListener("keyup", (event) => {
      if (holdKind !== "keyboard" || (event.code || event.key) !== activeKey)
        return;
      event.preventDefault();
      finishHold();
    });
    confirmButton.addEventListener("click", (event) => event.preventDefault());
    confirmButton.addEventListener("blur", () => {
      if (holdKind === "keyboard") clearHold();
    });
    window.addEventListener("blur", clearHold);
    root
      .querySelector("[data-sm-close]")!
      .addEventListener("click", () => setOpen(false));
    overlay.addEventListener("pointerdown", (event) => {
      if (event.target === overlay) setOpen(false);
    });
    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => showTab(tab.dataset.tab!));
      tab.addEventListener("keydown", (event) => {
        const step =
          event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0;
        if (event.key === "Home" || event.key === "End") {
          event.preventDefault();
          showTab(
            tabs[event.key === "Home" ? 0 : tabs.length - 1].dataset.tab!,
            true,
          );
        } else if (step) {
          event.preventDefault();
          showTab(
            tabs[(index + step + tabs.length) % tabs.length].dataset.tab!,
            true,
          );
        }
      });
    });
    settingsSubtabs.forEach((tab, index) => {
      tab.addEventListener("click", () =>
        showSettingsSubtab(
          tab.dataset.settingsSubtab as "fun" | "accessibility",
        ),
      );
      tab.addEventListener("keydown", (event) => {
        if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key))
          return;
        event.preventDefault();
        const nextIndex =
          event.key === "Home"
            ? 0
            : event.key === "End"
              ? settingsSubtabs.length - 1
              : (index +
                  (event.key === "ArrowRight" ? 1 : -1) +
                  settingsSubtabs.length) %
                settingsSubtabs.length;
        const next = settingsSubtabs[nextIndex];
        showSettingsSubtab(
          next.dataset.settingsSubtab as "fun" | "accessibility",
          true,
        );
      });
    });
    achievementTabs.forEach((tab, index) => {
      tab.addEventListener("click", () =>
        showAchievementCategory(tab.dataset.achievementCategory!),
      );
      tab.addEventListener("keydown", (event) => {
        if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key))
          return;
        event.preventDefault();
        const nextIndex =
          event.key === "Home"
            ? 0
            : event.key === "End"
              ? achievementTabs.length - 1
              : (index +
                  (event.key === "ArrowRight" ? 1 : -1) +
                  achievementTabs.length) %
                achievementTabs.length;
        showAchievementCategory(
          achievementTabs[nextIndex].dataset.achievementCategory!,
          true,
        );
      });
    });
    forceInput.addEventListener("change", () =>
      updateSettings({ forceTheme: forceInput.checked }),
    );
    motionInput.addEventListener("change", () =>
      updateSettings({ reducedMotion: motionInput.checked }),
    );
    plinkoExtremeInput.addEventListener("change", () =>
      updateSettings({ plinkoExtremeMode: plinkoExtremeInput.checked }),
    );

    // Keep keystrokes (space, letters) from reaching the music player's global shortcuts.
    overlay.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        if (isConfirmOpen()) {
          event.stopPropagation();
          setConfirmOpen(false);
        } else setOpen(false);
        return;
      }
      event.stopPropagation();
      if (event.key !== "Tab") return;
      const trapRoot = isConfirmOpen() ? confirmBox : panel;
      const focusable = Array.from(
        trapRoot.querySelectorAll<HTMLElement>('button, input, [tabindex="0"]'),
      ).filter(
        (element) => !element.closest("[hidden]") && element.tabIndex >= 0,
      );
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && isOpen() && !isConfirmOpen())
        setOpen(false);
    });
    document.addEventListener("astro:before-swap", () => {
      cancelCarouselDrag();
      setOpen(false);
    });

    window.addEventListener(CHANGE_EVENT, () => {
      render();
    });
    window.addEventListener(ACTIVITY_EVENT, () => {
      if (isOpen() && !infoView.hidden) renderInfoStats();
      if (isOpen() && !achievementsView.hidden) renderAchievements();
    });
    window.addEventListener(UNLOCK_EVENT, () => {
      render();
    });
    setupAchievementNotifications(root);
    initSiteState();
    render();
  };

  setupSettingsMenu();
  document.addEventListener("astro:page-load", setupSettingsMenu);
</script>
