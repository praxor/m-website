---
import AchievementNotifications from "./AchievementNotifications.astro";
---

<div
  class="settings-menu"
  data-settings-menu
  transition:persist="settings-menu"
  transition:animate="none"
>
  <div class="sm-overlay" data-sm-overlay data-open="false">
    <div
      id="settings-panel"
      class="sm-panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="sm-title"
    >
      <div class="sm-head">
        <h2 id="sm-title" class="sm-title">
          menu
        </h2>
        <div class="sm-tabs" role="tablist" aria-label="Menu sections">
          <button
            id="sm-tab-info"
            class="sm-tab"
            type="button"
            role="tab"
            aria-selected="true"
            aria-controls="sm-view-info"
            data-tab="info"
          >
            Info
          </button>
          <button
            id="sm-tab-achievements"
            class="sm-tab"
            type="button"
            role="tab"
            aria-selected="false"
            aria-controls="sm-view-achievements"
            tabindex="-1"
            data-tab="achievements"
          >
            Achievements
          </button>
          <button
            id="sm-tab-settings"
            class="sm-tab"
            type="button"
            role="tab"
            aria-selected="false"
            aria-controls="sm-view-settings"
            tabindex="-1"
            data-tab="settings"
          >
            Settings
          </button>
        </div>
        <button
          class="sm-close"
          type="button"
          aria-label="Close menu"
          data-sm-close
        >
          &#10005;
        </button>
      </div>

      <div
        id="sm-view-info"
        class="sm-view sm-info-view"
        role="tabpanel"
        aria-labelledby="sm-tab-info"
        tabindex="0"
      >
        <div class="sm-info-layout">
          <div class="sm-info-controls">
            <p class="sm-info-intro">Site stats</p>
            <dl class="sm-info-stats" data-info-stats></dl>
          </div>
          <div class="sm-info-stage" data-info-stage>
            <span class="sm-info-shadow" data-info-shadow aria-hidden="true"></span>
            <img
              class="sm-info-praxor"
              data-info-praxor
              role="button"
              tabindex="0"
              aria-label="Settings-xor"
              src="/media/res/oraxor.png"
              alt=""
              width="120"
              height="120"
              decoding="async"
            />
          </div>
        </div>
      </div>

      <div
        id="sm-view-achievements"
        class="sm-view"
        role="tabpanel"
        aria-labelledby="sm-tab-achievements"
        tabindex="0"
        hidden
      >
        <div
          class="sm-achievement-tabs"
          role="tablist"
          aria-label="Achievement categories"
          data-achievement-tabs
        >
          <button
            id="sm-achievement-tab-site"
            class="sm-achievement-tab"
            type="button"
            role="tab"
            aria-selected="true"
            aria-controls="sm-achievements-list"
            data-achievement-category="site"
            tabindex="0"
          >Site</button>
          <button
            id="sm-achievement-tab-characters"
            class="sm-achievement-tab"
            type="button"
            role="tab"
            aria-selected="false"
            aria-controls="sm-achievements-list"
            data-achievement-category="characters"
            tabindex="-1"
          >Characters</button>
          <button
            id="sm-achievement-tab-plinko"
            class="sm-achievement-tab"
            type="button"
            role="tab"
            aria-selected="false"
            aria-controls="sm-achievements-list"
            data-achievement-category="plinko"
            tabindex="-1"
          >Plinko</button>
          <button
            id="sm-achievement-tab-stats"
            class="sm-achievement-tab"
            type="button"
            role="tab"
            aria-selected="false"
            aria-controls="sm-achievements-list"
            data-achievement-category="stats"
            tabindex="-1"
          >Stats</button>
        </div>
        <div class="sm-summary" data-sm-summary></div>
        <ul
          id="sm-achievements-list"
          class="sm-achievements"
          data-sm-achievements
          role="tabpanel"
          aria-labelledby="sm-achievement-tab-site"
          tabindex="0"
        ></ul>
      </div>

      <div
        id="sm-view-settings"
        class="sm-view sm-settings-view"
        role="tabpanel"
        aria-labelledby="sm-tab-settings"
        tabindex="0"
        hidden
      >
        <fieldset class="sm-group sm-theme-group">
          <legend>Site Themes</legend>
          <div
            class="sm-theme-modes"
            role="group"
            aria-label="Theme appearance"
          >
            <button
              class="sm-theme-mode"
              type="button"
              data-theme-mode="dark"
              aria-pressed="true"
            >
              Dark
            </button>
            <button
              class="sm-theme-mode"
              type="button"
              data-theme-mode="light"
              aria-pressed="false"
            >
              Light
            </button>
          </div>
          <div class="sm-theme-carousel" data-sm-theme-carousel>
            <div class="sm-carousel-controls">
              <button
                class="sm-carousel-nav"
                type="button"
                data-sm-previous
                aria-label="Previous theme"
                title="Previous theme"
              >
                &#8249;
              </button>
              <span
                class="sm-carousel-position"
                data-sm-carousel-position
                aria-live="polite"
              ></span>
              <button
                class="sm-carousel-nav"
                type="button"
                data-sm-next
                aria-label="Next theme"
                title="Next theme"
              >
                &#8250;
              </button>
            </div>
            <div
              class="sm-carousel-viewport"
              data-sm-carousel-viewport
              tabindex="0"
              aria-label="Theme previews"
            >
              <div
                class="sm-carousel-track"
                data-sm-themes
                role="list"
                aria-label="Theme choices"
              ></div>
            </div>
            <div
              class="sm-carousel-dots"
              data-sm-carousel-dots
              role="group"
              aria-label="Theme preview positions"
            ></div>
          </div>
        </fieldset>

        <div
          class="sm-settings-tabs"
          role="tablist"
          aria-label="Settings categories"
        >
          <button
            id="sm-settings-tab-fun"
            class="sm-settings-tab"
            type="button"
            role="tab"
            aria-selected="true"
            aria-controls="sm-settings-fun"
            data-settings-subtab="fun"
          >
            Fun
          </button>
          <button
            id="sm-settings-tab-accessibility"
            class="sm-settings-tab"
            type="button"
            role="tab"
            aria-selected="false"
            aria-controls="sm-settings-accessibility"
            tabindex="-1"
            data-settings-subtab="accessibility"
          >
            Accessibility
          </button>
        </div>

        <div
          id="sm-settings-fun"
          class="sm-settings-subview"
          role="tabpanel"
          aria-labelledby="sm-settings-tab-fun"
        >
          <label class="sm-row">
            <span class="sm-row-text">
              <span class="sm-row-title">Plinko Extreme Mode</span>
              <span class="sm-row-hint">
                Makes the Plinko board Bigger and Badder.
              </span>
            </span>
            <input
              class="sm-switch"
              type="checkbox"
              role="switch"
              data-setting="plinkoExtremeMode"
            />
          </label>
          <label class="sm-row sm-disabled-setting" aria-disabled="true">
            <span class="sm-row-text">
              <span class="sm-row-title">???</span>
              <span class="sm-row-hint">???</span>
            </span>
            <input
              class="sm-switch"
              type="checkbox"
              role="switch"
              disabled
              aria-label="Unavailable setting"
              data-mystery-switch
            />
          </label>
        </div>

        <div
          id="sm-settings-accessibility"
          class="sm-settings-subview"
          role="tabpanel"
          aria-labelledby="sm-settings-tab-accessibility"
          hidden
        >
          <fieldset class="sm-group">
            <legend>Accessibility</legend>
            <label class="sm-row">
              <span class="sm-row-text">
                <span class="sm-row-title">Force Theme</span>
                <span class="sm-row-hint">
                  Override page-specific themes with the selected theme.
                </span>
              </span>
              <input
                class="sm-switch"
                type="checkbox"
                role="switch"
                data-setting="forceTheme"
              />
            </label>
            <label class="sm-row">
              <span class="sm-row-text">
                <span class="sm-row-title">Reduced Motion</span>
                <span class="sm-row-hint">
                  Minimize animations and movement.
                </span>
              </span>
              <input
                class="sm-switch"
                type="checkbox"
                role="switch"
                data-setting="reducedMotion"
              />
            </label>
          </fieldset>
        </div>

        <div
          class="sm-danger-zone sm-settings-danger sm-theme-profile"
          data-site-theme="praxorian"
        >
          <div class="sm-danger-title">Danger Zone</div>
          <button class="sm-danger" type="button" data-sm-reset>
            Reset Data
          </button>
        </div>
      </div>
    </div>

    <div class="sm-confirm" data-sm-confirm data-open="false">
      <div
        class="sm-confirm-panel"
        role="alertdialog"
        aria-modal="true"
        aria-labelledby="sm-confirm-title"
        aria-describedby="sm-confirm-desc"
      >
        <div class="sm-confirm-head">
          <div
            id="sm-confirm-title"
            class="sm-confirm-title"
            role="heading"
            aria-level="2"
          >
            Reset your saved data?
          </div>
          <button
            class="sm-confirm-close"
            type="button"
            data-sm-confirm-close
            aria-label="Close reset confirmation"
            title="Close"
          >
            <svg
              viewBox="0 0 16 16"
              width="15"
              height="15"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="m4 4 8 8M12 4l-8 8" />
            </svg>
          </button>
        </div>
        <div id="sm-confirm-desc" class="sm-confirm-desc">
          <div>
            This will reset pretty much <strong>ALL</strong> of your progress on
            the site.
          </div>
          <div>
            This includes achievements, unlocked themes, and settings toggled.{" "}
            <i>It will all be zero.</i>
          </div>
          <div class="sm-confirm-warn">
            I cannot restore your data, I don't care about your data. If you're
            speedrunning, just start your timer after the prompt, lol.
          </div>
        </div>
        <div class="sm-confirm-actions">
          <button
            class="sm-confirm-btn"
            type="button"
            data-sm-confirm-btn
            aria-label="Hold to Confirm"
          >
            <span
              class="sm-confirm-progress"
              data-sm-confirm-progress
              aria-hidden="true"
            ></span>
            <span class="sm-confirm-label" data-sm-confirm-label>
              Hold to Confirm
            </span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <AchievementNotifications />
</div>

<style is:global>
  /* Component styles: settings menu */
  /* Same pattern as the music player shell: above all page layers, click-through except its children. */
  .settings-menu {
    position: fixed;
    inset: 0;
    z-index: 300;
    pointer-events: none;
    view-transition-name: settings-menu;
  }
  ::view-transition-group(settings-menu),
  ::view-transition-old(settings-menu),
  ::view-transition-new(settings-menu) {
    animation: none;
    mix-blend-mode: normal;
  }
  ::view-transition-old(settings-menu),
  ::view-transition-new(settings-menu) {
    opacity: 1;
  }
  html.sm-open {
    overflow: hidden;
  }
  .sm-toggle {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 8px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    pointer-events: auto;
    transition:
      background-color 0.18s ease,
      color 0.18s ease,
      border-color 0.18s ease;
  }
  .sm-toggle:hover,
  .sm-toggle[aria-expanded="true"] {
    background: var(--accent-10);
    color: var(--text);
  }
  .sm-toggle:focus-visible,
  .sm-tab:focus-visible,
  .sm-close:focus-visible,
  .sm-view:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .sm-overlay {
    position: absolute;
    inset: 0;
    box-sizing: border-box;
    display: grid;
    place-items: center;
    padding: 12px;
    background: var(--overlay);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 0.22s ease,
      visibility 0.22s ease;
  }
  .sm-overlay[data-open="true"] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  .sm-panel {
    box-sizing: border-box;
    width: min(680px, 100%);
    min-width: 0;
    max-height: min(720px, calc(100vh - 24px));
    max-height: min(720px, calc(100dvh - 24px));
    display: flex;
    flex-direction: column;
    background: var(--card);
    color: var(--text);
    border: 1px solid var(--muted-border);
    border-radius: 10px;
    box-shadow:
      0 24px 70px var(--shadow-strong),
      0 0 0 1px var(--accent-12);
    transform: translateY(10px) scale(0.97);
    transition: transform 0.25s cubic-bezier(0.2, 0.9, 0.3, 1);
  }
  .sm-overlay[data-open="true"] .sm-panel {
    transform: none;
  }
  .sm-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px;
    padding: 10px 12px 0 18px;
    border-bottom: 1px solid var(--muted-border);
  }
  .sm-title {
    margin: 0;
    color: var(--accent);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: lowercase;
  }
  .sm-tabs {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-width: 0;
    gap: 2px;
  }
  .sm-tab {
    padding: 10px 9px;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    transition:
      color 0.14s ease,
      border-color 0.14s ease,
      background-color 0.14s ease;
  }
  .sm-tab:hover {
    color: var(--text);
  }
  .sm-tab[aria-selected="true"] {
    border-bottom-color: var(--accent);
    color: var(--text);
  }
  .sm-close {
    width: 32px;
    height: 32px;
    margin-bottom: 6px;
    padding: 0;
    border: 1px solid var(--muted-border);
    border-radius: 50%;
    background: transparent;
    color: var(--muted);
    font-size: 0.85rem;
    cursor: pointer;
  }
  .sm-close:hover {
    border-color: var(--accent);
    color: var(--text);
  }
  .sm-theme-group {
    padding: 10px 18px 8px;
    border-bottom: 1px solid var(--muted-border);
  }
  .sm-view {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-height: 0;
    padding: 18px;
    overflow-y: auto;
    transform-origin: top center;
  }
  .sm-info-view {
    align-self: center;
    width: min(460px, 100%);
    max-height: min(380px, calc(100dvh - 90px));
    gap: 10px;
  }
  .sm-settings-view {
    gap: 12px;
  }
  .sm-view[hidden] {
    display: none;
  }
  .sm-view:not([hidden])
    > :is(.sm-group, .sm-row, .sm-locked-setting, .sm-danger-zone) {
    animation: sm-row-enter 0.2s ease both;
  }
  .sm-view:not([hidden]) > :nth-child(2) {
    animation-delay: 0.025s;
  }
  .sm-view:not([hidden]) > :nth-child(3) {
    animation-delay: 0.05s;
  }
  .sm-view:not([hidden]) > :nth-child(4) {
    animation-delay: 0.075s;
  }
  @keyframes sm-row-enter {
    from {
      opacity: 0.72;
      transform: translateY(3px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .sm-group {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .sm-settings-tabs {
    display: flex;
    gap: 2px;
    border-bottom: 1px solid var(--muted-border);
  }
  .sm-settings-tab {
    padding: 8px 10px;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 0.76rem;
    font-weight: 600;
    cursor: pointer;
  }
  .sm-settings-tab[aria-selected="true"] {
    border-bottom-color: var(--accent);
    color: var(--text);
  }
  .sm-settings-tab:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .sm-settings-subview {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }
  .sm-settings-subview[hidden] {
    display: none;
  }
  .sm-info-intro {
    margin: 0 0 5px;
    color: var(--muted);
    font-size: 0.76rem;
  }
  .sm-info-stats {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    font-size: 0.68rem;
  }
  .sm-info-stat {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, auto);
    align-items: start;
    gap: 8px;
    padding: 3px 0;
    border-bottom: 1px solid var(--muted-border);
  }
  .sm-info-stat dt {
    color: var(--muted);
  }
  .sm-info-stat dd {
    max-width: 150px;
    margin: 0;
    color: var(--text);
    font-variant-numeric: tabular-nums;
    text-align: right;
    overflow-wrap: anywhere;
  }
  .sm-info-stage {
    position: relative;
    display: grid;
    place-items: center end;
    box-sizing: border-box;
    padding-right: 12px;
    min-height: 72px;
    height: auto;
    align-self: stretch;
    overflow: hidden;
  }
  .sm-info-praxor {
    position: relative;
    z-index: 1;
    display: block;
    width: 64px;
    height: 64px;
    object-fit: contain;
    transform-origin: center center;
    animation: none;
    transition: none;
    will-change: transform;
    cursor: pointer;
  }
  .sm-info-praxor:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .sm-info-shadow {
    position: absolute;
    right: 25px;
    top: calc(50% + 55px);
    width: 96px;
    height: 15px;
    border-radius: 50%;
    background: radial-gradient(
      ellipse,
      rgba(0, 0, 0, 0.82),
      rgba(0, 0, 0, 0.28) 44%,
      rgba(0, 0, 0, 0) 78%
    );
    filter: blur(1px);
    transform: scale(1);
    opacity: 0.3;
    animation: sm-info-shadow-bounce 1.65s ease-in-out infinite;
  }
  @keyframes sm-info-shadow-bounce {
    0%,
    100% {
      transform: scale(1);
      opacity: 0.3;
    }
    48%,
    54% {
      transform: scale(0.62);
      opacity: 0.13;
    }
  }
  :root[data-reduced-motion="true"] .sm-info-praxor,
  :root[data-reduced-motion="true"] .sm-info-shadow {
    animation: none !important;
  }
  @media (prefers-reduced-motion: reduce) {
    .sm-info-praxor,
    .sm-info-shadow {
      animation: none !important;
    }
  }
  .settings-menu .sm-switch::after,
  .settings-menu .sm-carousel-dot::before,
  .settings-menu .sm-carousel-dot[aria-current="true"]::before {
    border-radius: 0 !important;
  }
  .sm-disabled-setting {
    opacity: 0.48;
    cursor: not-allowed;
  }
  .sm-disabled-setting .sm-switch {
    cursor: not-allowed;
    opacity: 0.6;
  }
  .sm-group legend {
    padding: 0 0 8px;
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .sm-theme-carousel {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .sm-theme-modes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4px;
    margin-bottom: 7px;
    padding: 3px;
    border: 1px solid var(--muted-border);
    border-radius: 6px;
    background: var(--surface-inset);
  }
  .sm-theme-mode {
    min-height: 30px;
    padding: 4px 8px;
    border: 1px solid transparent;
    border-radius: 4px;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 0.72rem;
    font-weight: 700;
    cursor: pointer;
  }
  .sm-theme-mode[aria-pressed="true"] {
    border-color: var(--accent);
    background: var(--accent-10);
    color: var(--text);
  }
  .sm-theme-mode:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .sm-carousel-controls {
    display: grid;
    grid-template-columns: 32px 1fr 32px;
    align-items: center;
    gap: 8px;
  }
  .sm-carousel-position {
    color: var(--muted);
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;
    text-align: center;
  }
  .sm-carousel-nav {
    display: grid;
    place-items: center;
    width: 32px;
    height: 28px;
    padding: 0;
    border: 1px solid var(--muted-border);
    border-radius: 6px;
    background: var(--card);
    color: var(--text);
    font-size: 1.2rem;
    line-height: 1;
    cursor: pointer;
  }
  .sm-carousel-nav:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }
  .sm-carousel-nav:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .sm-carousel-viewport {
    overflow: hidden;
    padding: 3px 0;
    touch-action: pan-y;
    user-select: none;
    cursor: grab;
  }
  .sm-carousel-viewport[data-dragging="true"] {
    cursor: grabbing;
  }
  .sm-carousel-viewport:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .sm-carousel-track {
    display: flex;
    align-items: stretch;
    gap: 12px;
    width: 100%;
