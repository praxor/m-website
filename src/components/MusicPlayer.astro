---
const base = import.meta.env.BASE_URL;
import { Image } from 'astro:assets';
---
<div id="music-player-shell" transition:persist="music-player-shell" transition:animate="none">
<aside id="persistent-music-player" class="music-player" aria-label="Music player" data-persisted-shell data-playlist-url={`${base}musicplayer/playlists/all.json`} hidden>
	<audio id="music-audio" preload="metadata"></audio>
	<canvas id="music-visualizer" class="music-visualizer" aria-hidden="true"></canvas>
	<div class="music-player-main">
		<div class="music-track-info">
			<span class="music-eyebrow">now playing</span>
			<strong id="music-track-title">select a track</strong>
			<span id="music-track-time">0:00 / 0:00</span>
		</div>
		<div class="music-transport">
			<button class="music-control" type="button" data-action="shuffle" aria-label="Shuffle off" aria-pressed="false" title="Shuffle">&#8645;</button>
			<button class="music-control" type="button" data-action="previous" aria-label="Previous track">&#9664;&#9664;</button>
			<button class="music-control" type="button" data-action="seek-backward" aria-label="Seek back 10 seconds" title="Back 10 seconds">-10</button>
			<button class="music-control music-play" type="button" data-action="play" aria-label="Play">&#9654;</button>
			<button class="music-control" type="button" data-action="seek-forward" aria-label="Seek forward 10 seconds" title="Forward 10 seconds">+10</button>
			<button class="music-control" type="button" data-action="next" aria-label="Next track">&#9654;&#9654;</button>
			<button class="music-control" type="button" data-action="repeat" aria-label="Repeat off" aria-pressed="false" title="Repeat">&#8635;</button>
		</div>
		<div class="music-player-tools">
			<label class="music-volume" aria-label="Volume">
				<span aria-hidden="true">&#9835;</span>
				<input id="music-volume" type="range" min="0" max="1" step="0.01" value="0.8" />
			</label>
			<button class="music-control music-playlist-toggle" type="button" data-action="playlist" aria-expanded="false" aria-controls="music-playlist" aria-label="Toggle playlist">&#9776;</button>
		</div>
	</div>
	<div class="music-player-timeline">
		<input id="music-progress" class="music-progress" type="range" min="0" max="100" value="0" aria-label="Track progress" />
	</div>
	<div id="music-playlist" class="music-playlist" hidden></div>
</aside>

<div id="rolling-cats" class="rolling-cats" aria-hidden="true">
	<div class="rolling-cat-line">
		{Array.from({ length: 28 }, () => <span class="rolling-cat"><Image src="https://praxor.de/media/res/oraxor.png" alt="" width={44} height={44} loading="lazy" decoding="async" /></span>)}
	</div>
</div>

</div>

<style>
	.music-player{position:fixed;left:50%;bottom:calc(12px + env(safe-area-inset-bottom));z-index:200;width:min(720px,calc(100% - 28px));transform:translateX(-50%);background:var(--card);border:1px solid var(--muted-border);border-radius:9px;color:var(--text);overflow:visible;pointer-events:auto;isolation:isolate;transition:var(--theme-transition),background-color .22s ease,color .22s ease,border-color .22s ease}
	.music-player[hidden]{display:none}
	.music-player.player-entering{animation:music-player-enter .58s cubic-bezier(.2,.9,.2,1) both}
	@keyframes music-player-enter{from{opacity:0;transform:translate(-50%,24px) scale(.98)}to{opacity:1;transform:translate(-50%,0) scale(1)}}
	.music-visualizer{position:absolute;inset:0;z-index:0;width:100%;height:100%;opacity:.32;pointer-events:none}
	.music-player-main{position:relative;z-index:2;display:grid;grid-template-columns:minmax(105px,1fr) auto auto;align-items:center;gap:8px;padding:7px 10px 4px;width:100%;box-sizing:border-box;border-radius:9px;overflow:visible}
	.rolling-cats{display:none;position:fixed;left:0;right:0;bottom:0;z-index:48;height:48px;overflow:visible;pointer-events:none}
	.rolling-cats.is-active{display:block}
	.rolling-cat{position:absolute;left:-50px;bottom:0;display:none;width:44px;height:44px}
	.rolling-cat.spawned{display:block}
	.rolling-cat img{display:block;width:44px;height:44px;object-fit:contain}
	.music-control{display:grid;place-items:center;width:32px;height:32px;flex:0 0 32px;padding:0;border:1px solid var(--muted-border);border-radius:6px;background:rgba(0,0,0,.14);color:var(--muted);font:inherit;font-size:.68rem;line-height:1;cursor:pointer}
	.music-control:hover,.music-control:focus-visible{background:var(--accent-10);color:var(--text)}
	.music-play{background:var(--accent);color:var(--accent-contrast);font-size:.78rem}
	.music-play:hover,.music-play:focus-visible{background:var(--accent-dark);color:var(--accent-contrast)}
	.music-track-info{display:flex;flex-direction:column;min-width:0;overflow:hidden;line-height:1.1}
	.music-eyebrow{color:var(--accent);font-size:.58rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase}
	.music-track-info strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:.82rem;margin-top:3px}
	.music-track-info span{color:var(--muted);font-size:.7rem}
	.music-progress,.music-volume input{appearance:none;border:0;border-radius:2px;background:linear-gradient(to right,var(--accent) var(--fill,0%),var(--muted-border) var(--fill,0%));outline:0;cursor:pointer}
	.music-progress{width:100%;height:22px;margin:0;background:linear-gradient(to right,var(--accent) var(--fill,0%),var(--muted-border) var(--fill,0%)) center / 100% 4px no-repeat;touch-action:pan-x}
	.music-progress::-webkit-slider-thumb{appearance:none;width:14px;height:14px;border:2px solid var(--card);border-radius:50%;background:var(--accent);box-shadow:0 0 0 1px var(--accent)}
	.music-progress::-moz-range-thumb{width:12px;height:12px;border:2px solid var(--card);border-radius:50%;background:var(--accent);box-shadow:0 0 0 1px var(--accent)}
	.music-progress:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
	.music-volume input::-webkit-slider-thumb{appearance:none;width:10px;height:10px;border:0;border-radius:50%;background:var(--accent)}
	.music-volume input::-moz-range-thumb{width:10px;height:10px;border:0;border-radius:50%;background:var(--accent)}
	.music-player-timeline{position:relative;z-index:2;padding:0 12px 6px}
	.music-transport{display:flex;align-items:center;justify-content:center;gap:2px}
	.music-control[aria-pressed="true"]{background:var(--accent-10);color:var(--accent)}
	.music-player-tools{display:flex;align-items:center;gap:5px}
	.music-volume{display:flex;align-items:center;gap:4px;color:var(--muted);font-size:.85rem}
	.music-volume input{width:58px}
	.music-playlist{--playlist-max-height:min(260px,calc(100dvh - 120px));position:absolute;left:0;bottom:calc(100% + 8px);z-index:90;box-sizing:border-box;width:100%;max-height:var(--playlist-max-height);overflow-y:auto;border:1px solid var(--muted-border);border-radius:9px;background:var(--card);padding:4px;scrollbar-width:thin;scrollbar-color:var(--accent-dark) transparent;box-shadow:0 -10px 30px rgba(4,2,10,.28)}
	.music-playlist:not([hidden]){animation:music-playlist-in .24s cubic-bezier(.2,.9,.2,1) both}
	.music-playlist.playlist-settled:not(.playlist-closing){animation:none}
	.music-playlist.playlist-closing{animation:music-playlist-out .18s ease both}
	@keyframes music-playlist-in{from{opacity:0;transform:translateY(-7px);max-height:0}to{opacity:1;transform:translateY(0);max-height:var(--playlist-max-height)}}
	@keyframes music-playlist-out{from{opacity:1;transform:translateY(0);max-height:var(--playlist-max-height)}to{opacity:0;transform:translateY(-5px);max-height:0}}
	.music-track{width:100%;display:grid;grid-template-columns:18px 24px 1px minmax(0,1fr) auto;align-items:center;gap:7px;padding:6px 8px;border:1px solid transparent;border-radius:5px;background:transparent;color:var(--muted);font:inherit;font-size:.78rem;text-align:left;cursor:pointer}
	.music-track:hover,.music-track:focus-visible,.music-track.active{background:var(--accent-10);border-color:var(--muted-border);color:var(--text)}
	.music-track.active{border-color:var(--accent)}
	.music-track-play{color:var(--accent);font-size:.6rem;opacity:0}.music-track:hover .music-track-play,.music-track:focus-visible .music-track-play,.music-track.active .music-track-play{opacity:1}
	.music-track small{color:var(--accent)}
	.music-track-divider{height:15px;background:var(--muted-border)}
	.music-track-details{display:flex;min-width:0;align-items:center;gap:6px;overflow:hidden}.music-track-details strong,.music-track-details em{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.music-track-details strong{color:var(--muted);font-size:.75rem;font-weight:500}.music-track-details em{font-style:normal;font-weight:600}.music-track-details b{color:var(--accent)}.music-track time{color:var(--muted);font-size:.68rem}
	@media (max-width:600px){.music-player{bottom:calc(8px + env(safe-area-inset-bottom));width:calc(100% - 16px)}.music-player-main{grid-template-columns:minmax(0,1fr) auto;gap:5px 6px;padding:7px 7px 4px}.music-track-info{grid-column:1;grid-row:1}.music-player-tools{grid-column:2;grid-row:1}.music-transport{grid-column:1 / -1;grid-row:2;justify-content:space-between;gap:2px}.music-control{width:30px;height:30px;flex-basis:30px}.music-volume input{width:62px}.music-player-timeline{padding:0 10px 6px}.music-playlist{--playlist-max-height:min(220px,calc(100dvh - 120px))}.music-track{grid-template-columns:18px 22px 1px minmax(0,1fr) auto;gap:5px;padding:5px 6px}}
</style>

<style is:global>
	/* The view-transition-name on this wrapper makes it a stacking context; without a z-index, page cards (z-index:1) paint over the player. */
	#music-player-shell{position:fixed;inset:0;z-index:200;pointer-events:none;view-transition-name:music-player}
	/* Astro's "none" hides the old snapshot, so the player vanishes until the new page is ready; keep it visible. */
	::view-transition-group(music-player),::view-transition-old(music-player),::view-transition-new(music-player){animation:none;mix-blend-mode:normal}
	::view-transition-old(music-player){opacity:1}
	::view-transition-new(music-player){opacity:1}
	#persistent-music-player .music-track{width:100%;display:grid;grid-template-columns:18px 24px 1px minmax(0,1fr) auto;align-items:center;gap:7px;padding:6px 8px;border:1px solid transparent;border-radius:5px;background:transparent;color:var(--muted);font:inherit;font-size:.78rem;text-align:left;cursor:pointer}
	#persistent-music-player .music-track:hover,#persistent-music-player .music-track:focus-visible,#persistent-music-player .music-track.active{background:var(--accent-10);border-color:var(--muted-border);color:var(--text)}
	#persistent-music-player .music-track.active{border-color:var(--accent)}
	#persistent-music-player .music-track-play{color:var(--accent);font-size:.6rem;opacity:0}
	#persistent-music-player .music-track:hover .music-track-play,#persistent-music-player .music-track:focus-visible .music-track-play,#persistent-music-player .music-track.active .music-track-play{opacity:1}
	#persistent-music-player .music-track small{color:var(--accent)}
	#persistent-music-player .music-track-divider{height:15px;background:var(--muted-border)}
	#persistent-music-player .music-track-details{display:flex;min-width:0;align-items:center;gap:6px;overflow:hidden}
	#persistent-music-player .music-track-details strong,#persistent-music-player .music-track-details em{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
	#persistent-music-player .music-track-details strong{color:var(--muted);font-size:.75rem;font-weight:500}
	#persistent-music-player .music-track-details em{font-style:normal;font-weight:600}
	#persistent-music-player .music-track-details b{color:var(--accent)}
	#persistent-music-player .music-track time{color:var(--muted);font-size:.68rem}
	@media (max-width:600px){#persistent-music-player .music-track{grid-template-columns:18px 22px 1px minmax(0,1fr) auto;gap:5px;padding:5px 6px}}
</style>

<script>
	import { parseBlob } from 'music-metadata';

	const initializeMusicPlayer = () => {
	const player = document.querySelector<HTMLElement>('#persistent-music-player');
	if (!player || player.dataset.initialized === 'true') return;
	player.dataset.initialized = 'true';
	const audio = document.querySelector<HTMLAudioElement>('#music-audio');
	const playButton = player?.querySelector<HTMLButtonElement>('[data-action="play"]');
	const title = document.querySelector<HTMLElement>('#music-track-title');
	const time = document.querySelector<HTMLElement>('#music-track-time');
	const progress = document.querySelector<HTMLInputElement>('#music-progress');
	const volume = document.querySelector<HTMLInputElement>('#music-volume');
	const playlist = document.querySelector<HTMLElement>('#music-playlist');
	const playlistToggle = player?.querySelector<HTMLButtonElement>('[data-action="playlist"]');
	const shuffleButton = player?.querySelector<HTMLButtonElement>('[data-action="shuffle"]');
	const repeatButton = player?.querySelector<HTMLButtonElement>('[data-action="repeat"]');
	const visualizer = document.querySelector<HTMLCanvasElement>('#music-visualizer');
	const rollingCats = document.querySelector<HTMLElement>('#rolling-cats');
	const rollingCatNodes = rollingCats ? Array.from(rollingCats.querySelectorAll<HTMLElement>('.rolling-cat')) : [];
	let tracks: HTMLButtonElement[] = [];
	let currentTrack = -1;
	let shuffleEnabled = false;
	let shuffleOrder: number[] = [];
	let shufflePosition = -1;
	let repeatMode: 'off' | 'all' | 'one' = 'off';
	let pendingTrack = -1;
	let pendingAutoplay = true;
	let playlistUrl = player?.dataset.playlistUrl || '';
	let audioContext: AudioContext | null = null;
	let analyser: AnalyserNode | null = null;
	let sourceNode: MediaElementAudioSourceNode | null = null;
	let visualizerFrame = 0;
	let waveformState: number[] = [];
	type RollingCatState = {
		element: HTMLElement;
		lineIndex: number;
		x: number;
		y: number;
		velocityY: number;
		gravity: number;
		entryStartY: number;
		entryStartTime: number;
		entryDuration: number;
		entering: boolean;
		rotation: number;
		rotationVelocity: number;
		grounded: boolean;
		spawned: boolean;
		exitAfterLanding: boolean;
		exitStartTime: number;
		team: 'A' | 'B' | null;
	};
	const rollingCatStates: RollingCatState[] = rollingCatNodes.map((element) => ({
		element,
		lineIndex: -1,
		x: -50,
		y: 0,
		velocityY: 0,
		gravity: 980,
		entryStartY: 0,
		entryStartTime: 0,
		entryDuration: 0,
		entering: false,
		rotation: 0,
		rotationVelocity: 360,
		grounded: true,
		spawned: false,
		exitAfterLanding: false,
		exitStartTime: 0,
		team: null,
	}));
	const jumpEvents = [...Array.from({ length: 19 * 2 }, (_, index) => {
		const second = Math.floor(index / 2);
		return { time: 82 + second + (index % 2 ? .5 : 0), team: index % 2 ? 'B' as const : 'A' as const };
	}), ...Array.from({ length: 19 * 2 }, (_, index) => {
		const second = Math.floor(index / 2);
		return { time: 151 + second + (index % 2 ? .5 : 0), team: index % 2 ? 'B' as const : 'A' as const };
	})];
	const waveStart = 170;
	const waveEnd = 188;
	const waveRows = 4;
	const waveColumns = 7;
	const waveInterval = .27;
	const waveJumpVelocity = 400;
	const rollingExitWaveDuration = .7;
	let waveOrder: number[] = [];
	const jumpVelocity = 360;
	const rollingCatsEnterAt = 12;
	const rollingCatsLandAt = 13;
	const rollingCatsWaveDuration = 0.45;
	const rollingCatsEntryApex = 180;
	let rollingFrame = 0;
	let rollingPlayStart = 0;
	let previousAudioTime = 0;
	let nextJumpEvent = 0;
	let rollingActive = false;
	type RollingPhase = 'intro' | 'early-jumps' | 'interlude' | 'jumps' | 'wave' | 'rest' | 'final' | 'done';
	let rollingPhase: RollingPhase = 'intro';
	let nextWaveStep = 0;
	let rollingLineOffset = 0;
	let rollingLineSpacing = 48;
	let rollingLineLength = rollingCatStates.length * rollingLineSpacing;
	let audioIsSeeking = false;
	const seekThreshold = .75;
	const cancelCatAnimations = (element: HTMLElement) => {
		(element as HTMLElement & { getAnimations: () => Animation[] }).getAnimations().forEach((animation) => animation.cancel());
	};
	type EnrichedTrack = { title?: string; artist?: string; src?: string; duration?: string };
	const createShuffleOrder = () => {
		shuffleOrder = Array.from({ length: tracks.length }, (_, index) => index);
		for (let index = shuffleOrder.length - 1; index > 0; index -= 1) {
			const swapIndex = Math.floor(Math.random() * (index + 1));
			[shuffleOrder[index], shuffleOrder[swapIndex]] = [shuffleOrder[swapIndex], shuffleOrder[index]];
		}
		if (currentTrack >= 0) {
			shuffleOrder = [currentTrack, ...shuffleOrder.filter((index) => index !== currentTrack)];
			shufflePosition = 0;
		} else {
			shufflePosition = -1;
		}
	};

	const enrichTrack = async (track: { title?: string; artist?: string; src?: string; duration?: string }): Promise<EnrichedTrack> => {
		if (!track.src) return track;
		try {
			const response = await fetch(track.src);
			const metadata = await parseBlob(await response.blob());
			return {
				...track,
				title: metadata.common.title || track.title,
				artist: metadata.common.artist || track.artist,
				duration: track.duration || (metadata.format.duration ? formatTime(metadata.format.duration) : undefined),
			};
		} catch {
			return track;
		}
	};

	const renderPlaylist = async (playlistData: { tracks?: Array<{ title?: string; artist?: string; src?: string; duration?: string }> }) => {
		if (!playlist) return;
		playlist.replaceChildren();
		const tracksData = await Promise.all((playlistData.tracks || []).map(enrichTrack));
		tracksData.forEach((track, index) => {
			const button = document.createElement('button');
			button.className = 'music-track';
			button.type = 'button';
			button.dataset.playerTrack = String(index);
			button.dataset.playerSrc = track.src || '';
			button.dataset.playerTitle = track.title || `track ${index + 1}`;
			button.dataset.trackTitle = button.dataset.playerTitle;
			const artist = track.artist ? `<strong>${track.artist}</strong><b aria-hidden="true">·</b>` : '';
			button.innerHTML = `<span class="music-track-play" aria-hidden="true">▶</span><small>${String(index + 1).padStart(2, '0')}</small><span class="music-track-divider" aria-hidden="true"></span><span class="music-track-details">${artist}<em>${button.dataset.playerTitle}</em></span><time>${track.duration || '--:--'}</time>`;
			playlist.append(button);
		});
		tracks = Array.from(playlist.querySelectorAll<HTMLButtonElement>('[data-player-track]'));
		if (shuffleEnabled) createShuffleOrder();
		if (pendingTrack >= 0) {
			const requestedTrack = pendingTrack;
			pendingTrack = -1;
			selectTrack(requestedTrack, pendingAutoplay);
		}
	};

	const loadPlaylist = async (url = playlistUrl, trackIndex = -1, autoplay = true) => {
		if (!player) return;
		try {
			playlistUrl = url;
			if (trackIndex >= 0) {
				pendingTrack = trackIndex;
				pendingAutoplay = autoplay;
			}
			const response = await fetch(url, { cache: 'no-store' });
			if (!response.ok) throw new Error(`Playlist request failed: ${response.status}`);
			await renderPlaylist(await response.json());
		} catch (error) {
			console.error('Unable to load music playlist.', error);
		}
	};

	const formatTime = (seconds: number) => {
		if (!Number.isFinite(seconds)) return '0:00';
		return `${Math.floor(seconds / 60)}:${String(Math.floor(seconds % 60)).padStart(2, '0')}`;
	};

	const stopVisualizer = () => {
		if (visualizerFrame) cancelAnimationFrame(visualizerFrame);
		visualizerFrame = 0;
		waveformState = [];
		const context = visualizer?.getContext('2d');
		if (context && visualizer) context.clearRect(0, 0, visualizer.width, visualizer.height);
	};

	const drawVisualizer = () => {
		const playerAudio = audio;

		if (!visualizer || !analyser || !audioContext || !playerAudio || playerAudio.paused) {
			return;
		}

		const context = visualizer.getContext('2d');
		if (!context) return;

		const ratio = window.devicePixelRatio || 1;
		const width = visualizer.clientWidth;
		const height = visualizer.clientHeight;

		if (
			visualizer.width !== Math.round(width * ratio) ||
			visualizer.height !== Math.round(height * ratio)
		) {
			visualizer.width = Math.round(width * ratio);
			visualizer.height = Math.round(height * ratio);
		}

		context.setTransform(ratio, 0, 0, ratio, 0, 0);
		context.clearRect(0, 0, width, height);

		const samples = new Uint8Array(analyser.fftSize);
		analyser.getByteTimeDomainData(samples);

		context.beginPath();
		context.strokeStyle = getComputedStyle(document.documentElement)
			.getPropertyValue('--accent')
			.trim();

		context.lineWidth = 1;
		context.lineJoin = 'miter';
		context.lineCap = 'butt';

		for (let index = 0; index < samples.length; index += 2) {
			const x = (index / (samples.length - 1)) * width;
			const target = samples[index] / 255;

			const y = target * height * 1.36 - height * 0.18;

			if (index === 0) {
				context.moveTo(x, y);
			} else {
				context.lineTo(x, y);
			}
		}

		context.stroke();

		visualizerFrame = requestAnimationFrame(drawVisualizer);
	};

	const startVisualizer = async () => {
		if (!audio) return;

		if (!audioContext) {
			audioContext = new AudioContext();
			sourceNode = audioContext.createMediaElementSource(audio);
			analyser = audioContext.createAnalyser();

			analyser.fftSize = 2048;
			analyser.smoothingTimeConstant = 0;

			sourceNode.connect(analyser);
			analyser.connect(audioContext.destination);
		}

		if (audioContext.state === 'suspended') await audioContext.resume();

		if (!visualizerFrame) drawVisualizer();
	};

	const showPlayer = () => {
		if (!player) return;
		const firstAppearance = player.dataset.entered !== 'true';
		player.hidden = false;
		player.setAttribute('aria-hidden', 'false');
		if (firstAppearance) {
			player.dataset.entered = 'true';
			player.classList.add('player-entering');
			player.addEventListener('animationend', () => player.classList.remove('player-entering'), { once: true });
		}
	};

	const updatePlayButton = () => {
		if (!playButton || !audio) return;
		playButton.textContent = audio.paused ? '\u25b6' : '\u275a\u275a';
		playButton.setAttribute('aria-label', audio.paused ? 'Play' : 'Pause');
		player?.classList.toggle('is-playing', !audio.paused);
	};

	const selectTrack = (index: number, autoplay = true) => {
		const track = tracks[index];
		if (!track) {
			pendingTrack = index;
			pendingAutoplay = autoplay;
			return;
		}
		if (!audio) return;
		currentTrack = index;
		if (shuffleEnabled) shufflePosition = shuffleOrder.indexOf(index);
		audio.src = track.dataset.playerSrc || '';
		audio.load();
		if (title) title.textContent = track.dataset.playerTitle || 'track';
		const isRollingGirl = (track.dataset.playerTitle || '').toLowerCase().includes('rolling girl');
		player.classList.toggle('rolling-girl', isRollingGirl);
		resetRollingCats();
		tracks.forEach((item, itemIndex) => item.classList.toggle('active', itemIndex === index));
		window.dispatchEvent(new CustomEvent('music:track-change', { detail: { index, title: track.dataset.playerTitle || 'track', src: audio.src } }));
		showPlayer();
		if (autoplay) void audio.play();
	};

	const resetRollingCats = () => {
		rollingActive = Boolean(audio && player?.classList.contains('rolling-girl'));
		rollingPlayStart = audio?.currentTime || 0;
		previousAudioTime = rollingPlayStart;
		nextJumpEvent = jumpEvents.findIndex((event) => event.time > rollingPlayStart);
		if (nextJumpEvent < 0) nextJumpEvent = jumpEvents.length;
		rollingPhase = 'intro';
		nextWaveStep = 0;
		rollingLineOffset = 0;
		rollingCats?.classList.remove('is-active');
		rollingCatStates.forEach((cat) => {
			cancelCatAnimations(cat.element);
			cat.element.classList.remove('spawned');
			cat.spawned = false;
			cat.team = null;
			cat.lineIndex = -1;
			cat.x = -50;
			cat.y = 0;
			cat.velocityY = 0;
			cat.entryStartY = 0;
			cat.entryStartTime = 0;
			cat.entryDuration = 0;
			cat.entering = false;
			cat.grounded = true;
			cat.exitAfterLanding = false;
			cat.exitStartTime = 0;
			cat.element.style.transform = 'translate3d(-50px, 0, 0) rotate(0deg)';
		});
	};

	const jumpTeam = (team: 'A' | 'B') => {
		rollingCatStates.filter((cat) => cat.spawned && cat.team === team && cat.grounded).forEach((cat) => {
			cat.velocityY = jumpVelocity;
			cat.grounded = false;
		});
	};

	const jumpCat = (cat: RollingCatState, exitAfterLanding = false, velocity = jumpVelocity) => {
		if (!cat.spawned || !cat.grounded) return;
		cat.velocityY = velocity;
		cat.grounded = false;
		cat.exitAfterLanding = exitAfterLanding;
	};

	const resetCatBodies = () => {
		rollingCats?.classList.remove('is-active');
		rollingCatStates.forEach((cat) => {
			cancelCatAnimations(cat.element);
			cat.element.classList.remove('spawned');
			cat.spawned = false;
			cat.team = null;
			cat.lineIndex = -1;
			cat.x = -50;
			cat.y = 0;
			cat.velocityY = 0;
			cat.entryStartY = 0;
			cat.entryStartTime = 0;
			cat.entryDuration = 0;
			cat.entering = false;
			cat.grounded = true;
			cat.exitAfterLanding = false;
			cat.exitStartTime = 0;
			cat.element.style.transform = 'translate3d(-50px, 0, 0) rotate(0deg)';
		});
	};

	const positionRollingCats = (entering = false) => {
		resetCatBodies();
		rollingLineLength = Math.max(rollingCatStates.length * 48, window.innerWidth + 44);
		rollingLineSpacing = rollingLineLength / rollingCatStates.length;
		rollingCatStates.forEach((cat, index) => {
			cat.spawned = true;
			cat.team = index % 2 === 0 ? 'A' : 'B';
			cat.lineIndex = index;
			cat.x = rollingLineOffset + index * rollingLineSpacing;
			const waveProgress = index / Math.max(rollingCatStates.length - 1, 1);
			cat.entryStartY = entering ? -44 : 0;
			cat.entryStartTime = rollingCatsEnterAt + waveProgress * rollingCatsWaveDuration;
			cat.entryDuration = rollingCatsLandAt - cat.entryStartTime;
			cat.entering = entering;
			cat.y = cat.entryStartY;
			cat.velocityY = 0;
			cat.rotation = 0;
			cat.rotationVelocity = 360;
			cat.grounded = !entering;
			cat.exitAfterLanding = false;
			cat.element.style.bottom = '0px';
			cat.element.dataset.team = cat.team;
			cat.element.classList.add('spawned');
			cat.element.style.transform = `translate3d(${cat.x - 44}px, ${-cat.y}px, 0) rotate(0deg)`;
		});
		rollingCats?.classList.add('is-active');
	};

	const phaseForTime = (time: number): RollingPhase => {
		if (time < 82) return 'intro';
		if (time < 101) return 'early-jumps';
		if (time < 151) return 'interlude';
		if (time < waveStart) return 'jumps';
		if (time < waveEnd) return 'wave';
		if (time < 189) return 'rest';
		if (time < 192) return 'final';
		return 'done';
	};

	const enterRollingPhase = (phase: RollingPhase, time: number) => {
		if (rollingPhase === phase) return;
		rollingPhase = phase;
		if (phase === 'intro') {
			if (time >= rollingCatsEnterAt && !rollingCatStates.some((cat) => cat.spawned)) {
				positionRollingCats(time < rollingCatsLandAt);
			}
		} else if (phase === 'early-jumps' || phase === 'interlude' || phase === 'jumps') {
			if (!rollingCatStates.some((cat) => cat.spawned)) positionRollingCats();
		} else if (phase === 'wave') {
			if (!rollingCatStates.some((cat) => cat.spawned)) positionRollingCats();
			waveOrder = [
				...Array.from({ length: waveColumns }, (_, index) => waveColumns - index - 1),
				...Array.from({ length: waveColumns - 2 }, (_, index) => index + 1),
			];
			nextWaveStep = Math.max(0, Math.floor((time - waveStart) / waveInterval));
		} else if (phase === 'rest') {
			if (!rollingCatStates.some((cat) => cat.spawned)) positionRollingCats();
		} else if (phase === 'final') {
			if (!rollingCatStates.some((cat) => cat.spawned)) positionRollingCats();
			rollingCatStates.forEach((cat) => {
				cat.exitStartTime = time + (cat.lineIndex / Math.max(rollingCatStates.length - 1, 1)) * rollingExitWaveDuration;
			});
		} else if (phase === 'done') {
			resetCatBodies();
		}
	};

	const synchronizeToAudioTime = (currentTime: number) => {
		resetCatBodies();
		if (!rollingActive || !player?.classList.contains('rolling-girl')) {
			rollingPhase = 'done';
			previousAudioTime = currentTime;
			return;
		}
		nextJumpEvent = jumpEvents.findIndex((event) => event.time > currentTime);
		if (nextJumpEvent < 0) nextJumpEvent = jumpEvents.length;
		rollingPhase = 'done';
		enterRollingPhase(phaseForTime(currentTime), currentTime);
		previousAudioTime = currentTime;
	};

	const updateRollingPhysics = (deltaTime: number) => {
		if (!audio) return;
		const currentTime = audio.currentTime;
		if (audioIsSeeking) {
			previousAudioTime = currentTime;
			return;
		}
		if (Math.abs(currentTime - previousAudioTime) > seekThreshold) {
			synchronizeToAudioTime(currentTime);
			return;
		}
		if (currentTime < previousAudioTime - .25) {
			rollingActive = player?.classList.contains('rolling-girl') ?? false;
			synchronizeToAudioTime(currentTime);
			return;
		}
		if (!rollingActive || audio.paused) return;
		enterRollingPhase(phaseForTime(currentTime), currentTime);
		if (rollingPhase === 'intro' && currentTime >= rollingCatsEnterAt && !rollingCatStates.some((cat) => cat.spawned)) {
			positionRollingCats(currentTime < rollingCatsLandAt);
		}
		if (currentTime < previousAudioTime - .25) previousAudioTime = currentTime;
		while (nextJumpEvent < jumpEvents.length && jumpEvents[nextJumpEvent].time <= currentTime) {
			if (jumpEvents[nextJumpEvent].time > previousAudioTime) jumpTeam(jumpEvents[nextJumpEvent].team);
			nextJumpEvent += 1;
		}
		while (rollingPhase === 'wave' && waveStart + nextWaveStep * waveInterval <= currentTime && waveStart + nextWaveStep * waveInterval < waveEnd) {
			const column = waveOrder[nextWaveStep % waveOrder.length];
			Array.from({ length: waveRows }, (_, row) => rollingCatStates[row * waveColumns + column])
				.forEach((cat) => { if (cat) jumpCat(cat, false, waveJumpVelocity); });
			nextWaveStep += 1;
		}
		previousAudioTime = currentTime;
		const activeLine = rollingCatStates.filter((cat) => cat.spawned).sort((first, second) => first.lineIndex - second.lineIndex);
		if (activeLine.length) {
			rollingLineOffset = (rollingLineOffset + 130 * deltaTime) % rollingLineLength;
		}
		rollingCatStates.forEach((cat) => {
			if (!cat.spawned) return;
			cat.x = (rollingLineOffset + cat.lineIndex * rollingLineSpacing) % rollingLineLength;
			if (rollingPhase === 'final' && cat.grounded && currentTime >= cat.exitStartTime) {
				cat.exitAfterLanding = true;
				jumpCat(cat, true);
			}
			if (cat.entering) {
				if (currentTime >= rollingCatsLandAt) {
					cat.y = 0;
					cat.velocityY = 0;
					cat.grounded = true;
					cat.entering = false;
				} else if (currentTime >= cat.entryStartTime) {
					const entryProgress = Math.min((currentTime - cat.entryStartTime) / cat.entryDuration, 1);
					cat.y = cat.entryStartY * (1 - entryProgress) + 4 * rollingCatsEntryApex * entryProgress * (1 - entryProgress);
				} else {
					cat.y = cat.entryStartY;
				}
			} else {
				cat.y += cat.velocityY * deltaTime;
				cat.velocityY -= cat.gravity * deltaTime;
				if (cat.y <= 0 && !cat.exitAfterLanding) { cat.y = 0; cat.velocityY = 0; cat.grounded = true; }
			}
			cat.rotation += cat.rotationVelocity * deltaTime;
			cat.element.style.transform = `translate3d(${cat.x - 44}px, ${-cat.y}px, 0) rotate(${cat.rotation}deg)`;
			if (cat.exitAfterLanding && cat.y < -(window.innerHeight + 60)) {
				cat.spawned = false;
				cat.element.classList.remove('spawned');
			}
		});
	};

	const rollingAnimationLoop = (timestamp: number) => {
		const previous = Number(player?.dataset.rollingFrame || timestamp);
		const deltaTime = Math.min((timestamp - previous) / 1000, .05);
		if (player) player.dataset.rollingFrame = String(timestamp);
		updateRollingPhysics(deltaTime);
		rollingFrame = requestAnimationFrame(rollingAnimationLoop);
	};

	const stepTrack = (direction: number, ended = false) => {
		if (!tracks.length) return;
		if (currentTrack < 0) {
			selectTrack(shuffleEnabled ? (shuffleOrder[0] ?? 0) : 0);
			return;
		}
		if (ended && repeatMode === 'one' && audio) {
			audio.currentTime = 0;
			void audio.play();
			return;
		}
		if (ended && repeatMode === 'off' && !shuffleEnabled && currentTrack === tracks.length - 1) return;
		let next: number;
		if (shuffleEnabled) {
			if (ended && repeatMode === 'off' && shufflePosition === shuffleOrder.length - 1) return;
			shufflePosition = (shufflePosition + direction + shuffleOrder.length) % shuffleOrder.length;
			next = shuffleOrder[shufflePosition];
		} else {
			next = (currentTrack + direction + tracks.length) % tracks.length;
		}
		selectTrack(next);
	};

	player?.addEventListener('click', (event) => {
		const target = event.target as HTMLElement;
		const actionButton = target.closest<HTMLButtonElement>('[data-action]');
		const trackButton = target.closest<HTMLButtonElement>('[data-player-track]');
		if (trackButton) {
			const index = Number(trackButton.dataset.playerTrack);
			if (index === currentTrack && audio) { if (audio.paused) void audio.play(); else audio.pause(); }
			else selectTrack(index);
		}
		if (!actionButton || !audio) return;
		if (actionButton.dataset.action === 'play') {
			if (currentTrack < 0) selectTrack(0);
			else if (audio.paused) void audio.play();
			else audio.pause();
		}
		if (actionButton.dataset.action === 'previous') stepTrack(-1);
		if (actionButton.dataset.action === 'next') stepTrack(1);
		if (actionButton.dataset.action === 'seek-backward') audio.currentTime = Math.max(0, audio.currentTime - 10);
		if (actionButton.dataset.action === 'seek-forward') audio.currentTime = Math.min(audio.duration || Infinity, audio.currentTime + 10);
		if (actionButton.dataset.action === 'shuffle' && shuffleButton) {
			shuffleEnabled = !shuffleEnabled;
			if (shuffleEnabled) createShuffleOrder();
			else { shuffleOrder = []; shufflePosition = -1; }
			shuffleButton.setAttribute('aria-pressed', String(shuffleEnabled));
			shuffleButton.setAttribute('aria-label', `Shuffle ${shuffleEnabled ? 'on' : 'off'}`);
		}
		if (actionButton.dataset.action === 'repeat' && repeatButton) {
			repeatMode = repeatMode === 'off' ? 'all' : repeatMode === 'all' ? 'one' : 'off';
			repeatButton.textContent = repeatMode === 'one' ? '1↻' : '↻';
			repeatButton.setAttribute('aria-pressed', String(repeatMode !== 'off'));
			repeatButton.setAttribute('aria-label', `Repeat ${repeatMode}`);
		}
		if (actionButton.dataset.action === 'playlist' && playlist && playlistToggle) {
			const isOpen = !playlist.hidden;
			if (isOpen) {
				playlist.classList.remove('playlist-settled');
				playlist.classList.add('playlist-closing');
				playlist.addEventListener('animationend', () => {
					playlist.hidden = true;
					playlist.classList.remove('playlist-closing');
				}, { once: true });
			} else {
				playlist.hidden = false;
				playlist.addEventListener('animationend', () => playlist.classList.add('playlist-settled'), { once: true });
			}
			playlistToggle.setAttribute('aria-expanded', String(!isOpen));
		}
	});

	audio?.addEventListener('play', () => { updatePlayButton(); void startVisualizer(); });
	audio?.addEventListener('pause', () => { updatePlayButton(); stopVisualizer(); });
	audio?.addEventListener('seeking', () => { audioIsSeeking = true; });
	audio?.addEventListener('seeked', () => { audioIsSeeking = false; synchronizeToAudioTime(audio.currentTime); });
	audio?.addEventListener('ended', () => stepTrack(1, true));
	audio?.addEventListener('timeupdate', () => {
		if (!audio || !progress || !time) return;
		const fill = audio.duration ? (audio.currentTime / audio.duration) * 100 : 0;
		progress.value = String(fill);
		progress.style.setProperty('--fill', `${fill}%`);
		time.textContent = `${formatTime(audio.currentTime)} / ${formatTime(audio.duration)}`;
	});
	progress?.addEventListener('input', () => {
		if (audio?.duration) {
			audio.currentTime = (Number(progress.value) / 100) * audio.duration;
			progress.style.setProperty('--fill', `${progress.value}%`);
		}
	});
	volume?.addEventListener('input', () => {
		if (audio) audio.volume = Number(volume.value);
		volume.style.setProperty('--fill', `${Number(volume.value) * 100}%`);
	});
	if (audio && volume) {
		audio.volume = Number(volume.value);
		volume.style.setProperty('--fill', `${Number(volume.value) * 100}%`);
	}

	document.addEventListener('click', (event) => {
		const target = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-player-launch]');
		if (!target) return;
		const trackIndex = Number(target.dataset.playerLaunch || 0);
		const samePlaylist = !target.dataset.playerPlaylist || target.dataset.playerPlaylist === playlistUrl;
		if (audio && samePlaylist && trackIndex === currentTrack && tracks.length) {
			if (audio.paused) void audio.play(); else audio.pause();
			return;
		}
		if (target.dataset.playerPlaylist) void loadPlaylist(target.dataset.playerPlaylist, trackIndex);
		else selectTrack(trackIndex);
	});

	document.addEventListener('click', (event) => {
		// Mouse clicks (detail > 0) shouldn't leave buttons focused, or Space re-triggers them instead of play/pause.
		const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button');
		if (button && event.detail > 0) requestAnimationFrame(() => button.blur());
	});

	document.addEventListener('keydown', (event) => {
		if (!audio || currentTrack < 0 || event.ctrlKey || event.metaKey || event.altKey) return;
		const target = event.target as HTMLElement;
		if (target.isContentEditable || target.closest('input:not([type="range"]), textarea, select')) return;
		const onRange = target.matches('input[type="range"]');
		const onButton = target.closest('button, a, summary');
		const click = (action: string) => player.querySelector<HTMLButtonElement>(`[data-action="${action}"]`)?.click();
		const key = event.key.toLowerCase();
		if ((key === ' ' && !onButton && !onRange) || key === 'k') {
			click('play');
		} else if (key === 'j' || (key === 'arrowleft' && !onRange)) audio.currentTime = Math.max(0, audio.currentTime - (key === 'j' ? 10 : 5));
		else if (key === 'l' || (key === 'arrowright' && !onRange)) audio.currentTime = Math.min(audio.duration || Infinity, audio.currentTime + (key === 'l' ? 10 : 5));
		else if (key === 'arrowup' && !onRange) { if (volume) { volume.value = String(Math.min(1, Number(volume.value) + .05)); volume.dispatchEvent(new Event('input')); } }
		else if (key === 'arrowdown' && !onRange) { if (volume) { volume.value = String(Math.max(0, Number(volume.value) - .05)); volume.dispatchEvent(new Event('input')); } }
		else if (key === 'm') audio.muted = !audio.muted;
		else if (key === 'n') click('next');
		else if (key === 'p') click('previous');
		else if (key === 's') click('shuffle');
		else if (key === 'r') click('repeat');
		else if (key >= '0' && key <= '9' && audio.duration) audio.currentTime = audio.duration * Number(key) / 10;
		else return;
		event.preventDefault();
	});

	void loadPlaylist();
	resetRollingCats();
	rollingFrame = requestAnimationFrame(rollingAnimationLoop);
	};

	document.addEventListener('astro:page-load', initializeMusicPlayer);
	initializeMusicPlayer();

	// Moving the persisted player during a swap resets playlist scroll and can pause audio.
	let swapState: { scroll: number; playing: boolean } | null = null;
	document.addEventListener('astro:before-swap', () => {
		const list = document.querySelector<HTMLElement>('#music-playlist');
		const media = document.querySelector<HTMLAudioElement>('#music-audio');
		swapState = { scroll: list?.scrollTop ?? 0, playing: !!media && !media.paused && !media.ended };
	});
	document.addEventListener('astro:after-swap', () => {
		if (!swapState) return;
		const { scroll, playing } = swapState;
		swapState = null;
		const restore = () => {
			const list = document.querySelector<HTMLElement>('#music-playlist');
			const media = document.querySelector<HTMLAudioElement>('#music-audio');
			if (list) list.scrollTop = scroll;
			if (playing && media?.paused && !media.ended) void media.play().catch(() => {});
		};
		restore();
		requestAnimationFrame(restore);
	});
</script>
