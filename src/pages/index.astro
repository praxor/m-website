---
import Layout from '../layouts/Layout.astro';
---

<Layout title="home" description="welcome... my website society...">
	<main>
			<section class="home-hero" aria-labelledby="home-title">
				<div class="hero-copy">
					<p class="hero-kicker">welcome to my website</p>
					<p class="hero-lead">visit and do whatever else you do. meow.</p>
				</div>
				<div class="cat-stage" aria-label="A wandering cat">
					<div class="cat-shadow" aria-hidden="true"></div>
					<button class="cat-trigger" type="button" aria-label="Interact with oraxor the cat (what the fuck is wrong with me)">
						<img class="bouncy-cat" src="https://praxor.de/media/res/oraxor.png" alt="oraxor the cat" width="300" height="300" fetchpriority="high" decoding="async" />
					</button>
				</div>
			</section>
	</main>
</Layout>

<style>
	.home-hero{max-width:1100px;min-height:calc(100vh - 76px);margin:0 auto;padding:clamp(4rem,10vw,8rem) 20px 5rem;display:grid;grid-template-columns:minmax(0,1fr) minmax(260px,420px);align-items:center;gap:clamp(2rem,8vw,7rem);box-sizing:border-box}
	.hero-copy{max-width:600px}
	.hero-kicker{margin:0 0 1rem;color:var(--accent);font-size:.8rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
	.hero-copy h1{margin:0;color:var(--text);font-size:clamp(3rem,8vw,7rem);line-height:.95;letter-spacing:0}
	.hero-lead{max-width:30rem;margin:1.5rem 0 0;color:var(--muted);font-size:clamp(1rem,2vw,1.25rem)}
	.cat-stage{position:relative;display:grid;place-items:center;min-height:360px}
	.cat-trigger{position:relative;z-index:1;width:min(68vw,300px);height:min(68vw,300px);padding:0;border:0;background:transparent;cursor:pointer}
	.bouncy-cat{position:relative;width:100%;height:100%;object-fit:cover;display:block;opacity:1;transform:none;animation:cat-bounce 1.8s ease-in-out infinite;will-change:transform}
	.cat-shadow{display:none}
	@keyframes cat-bounce{
		0%,100%{transform:translateY(0)}
		50%{transform:translateY(-64px)}
	}
	@keyframes cat-hover-spin{
		from{transform:translateY(0) rotate(0deg)}
		to{transform:translateY(0) rotate(360deg)}
	}
	.cat-trigger:hover .bouncy-cat,.cat-trigger:focus-visible .bouncy-cat{animation:cat-hover-spin 1.2s linear 1s infinite both}
	.cat-trigger:focus-visible{outline:3px solid var(--accent);outline-offset:8px;border-radius:4px}
	@media (max-width:780px){
		.home-hero{min-height:calc(100vh - 60px);grid-template-columns:1fr;padding-top:4rem;gap:1rem;text-align:center}
		.hero-copy{margin:0 auto}
		.hero-lead{margin-left:auto;margin-right:auto}
		.cat-stage{min-height:300px}
	}
	@media (prefers-reduced-motion:reduce){
		.bouncy-cat{animation:none}
		.cat-trigger:hover .bouncy-cat,.cat-trigger:focus-visible .bouncy-cat{animation:none}
	}
</style>

<script>
	if (Math.random() < 0.01) {
		window.location.replace('/surprise/');
	}

	const catTrigger = document.querySelector<HTMLButtonElement>('.cat-trigger');
	catTrigger?.addEventListener('click', () => {
		window.location.href = 'https://praxor.de/media/paxogroove.mp4';
	});
</script>
