---
import Layout from '../layouts/Layout.astro';
import { mainCharacters, miscCharacters } from '../data/characters';
const base = import.meta.env.BASE_URL;
---
<Layout title="characters" description="see my swag, cuh.">
    <main class="characters-main">
      <header class="characters-heading">
        <h1>characters</h1>
        <p>these are my ocs. choose an oc to open their page.</p>
      </header>
      <section class="character-section" aria-labelledby="main-characters-title">
        <h2 id="main-characters-title">main characters</h2>
        <div class="section-divider" aria-hidden="true"></div>
        <nav class="character-list" aria-label="Main characters">
          {mainCharacters.map((character, index) => <a class="character-choice" href={`${base}characters/${character.slug}`}><span class="character-number">{String(index + 1).padStart(2, '0')}</span><span class="character-portrait" aria-hidden="true">{character.image ? <img src={character.image} alt="" /> : <span>portrait slot</span>}</span><span class="character-choice-name">{character.name}</span><span class="character-arrow" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M7 17L17 7M17 7H8M17 7V16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></span></a>)}
        </nav>
        <a class="pre-axis-button" href={`${base}characters/pre-axis`}>information on pre-axis versions of praxor (e.g. spaceman praxor)</a>
      </section>
      <section class="character-section" aria-labelledby="misc-characters-title">
        <h2 id="misc-characters-title">alt / misc. characters</h2>
        <div class="section-divider" aria-hidden="true"></div>
        <nav class="character-list" aria-label="Alternate and miscellaneous characters">
          {miscCharacters.map((character, index) => <a class="character-choice" href={`${base}characters/${character.slug}`}><span class="character-number">{String(index + 1).padStart(2, '0')}</span><span class="character-portrait" aria-hidden="true">{character.image ? <img src={character.image} alt="" /> : <span>portrait slot</span>}</span><span class="character-choice-name">{character.name}</span><span class="character-arrow" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M7 17L17 7M17 7H8M17 7V16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></span></a>)}
        </nav>
      </section>
    </main>
</Layout>

<style>
  .characters-main{max-width:1000px;margin:clamp(2rem,6vw,5rem) auto;padding:clamp(2rem,5vw,3.5rem);background:var(--card);border:1px solid var(--muted-border);border-radius:16px;box-shadow:inset 0 1px 0 var(--accent-12)}
  .characters-heading{max-width:620px;margin:0 auto 1.5rem;text-align:center}
  .characters-heading h1{margin:0;color:var(--accent);font-size:1.15rem;line-height:1;letter-spacing:.04em}
  .characters-heading>p:last-child{margin:1rem 0 0;color:var(--muted);font-size:1.05rem}
  .character-section{margin-top:2.75rem}.character-section h2{margin:0;color:var(--accent);font-size:1rem;text-transform:lowercase}.section-divider{height:1px;margin:.8rem 0 1rem;background:var(--muted-border)}
  .character-list{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
  .character-choice{position:relative;isolation:isolate;display:flex;aspect-ratio:1;min-height:0;flex-direction:column;justify-content:flex-end;overflow:hidden;padding:14px;background:var(--card);border:1px solid var(--muted-border);border-radius:9px;color:var(--text);text-decoration:none;transition:transform .2s ease,border-color .2s ease,background .2s ease}
  .character-choice:hover,.character-choice:focus-visible{transform:translateY(-4px);border-color:var(--accent);background:var(--accent-10)}
  .character-portrait::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(11,6,20,.08) 45%,rgba(11,6,20,.78));pointer-events:none}
  .character-number{position:absolute;top:14px;left:14px;z-index:2;color:var(--accent);font-size:.72rem;font-weight:700;letter-spacing:.1em;text-shadow:0 1px 8px rgba(11,6,20,.9)}
  .character-portrait{display:grid;place-items:center;flex:1;min-height:0;margin:-14px -14px 16px;border-bottom:1px solid var(--muted-border);color:var(--muted);font-size:.72rem;letter-spacing:.1em;text-transform:uppercase}
  .character-portrait img{position:relative;z-index:0;width:100%;height:100%;object-fit:contain}
  .character-choice-name{position:relative;z-index:2;font-size:1.15rem;font-weight:700;text-align:center;text-shadow:0 1px 8px rgba(11,6,20,.95)}
  .character-arrow{position:absolute;top:12px;right:12px;z-index:3;display:flex;width:18px;height:18px;align-items:center;justify-content:center;color:var(--accent)}
  .character-arrow svg{display:block;width:18px;height:18px}
  .pre-axis-button{display:block;width:max-content;margin:1.2rem auto 0;padding:10px 13px;border:1px solid var(--muted-border);border-radius:7px;color:var(--muted);font-size:.85rem;text-decoration:none}.pre-axis-button:hover{color:var(--text);background:var(--accent-10)}
  @media (max-width:900px){.character-list{grid-template-columns:repeat(3,minmax(0,1fr))}}
  @media (max-width:760px){.character-list{grid-template-columns:1fr 1fr}}
  @media (max-width:480px){.characters-main{margin:1rem 12px;padding:1.5rem 12px}.character-list{grid-template-columns:1fr}}
</style>
