---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import ImageGallery from "../components/ImageGallery.astro";
import { fanartByNumber } from "../data/fanart";

const art = fanartByNumber.get(1)!;
const galleryItems = [
  {
    src: art.src,
    alt: "Heian-era praxor design",
    width: art.width,
    height: art.height,
    caption: art.caption ?? "",
    credit: art.artist,
  },
];
---

<Layout title="pre-axis" description="the designs that came before axis.">
  <main class="pa-main">
    <a class="pa-back" href="/characters">
      ← back to characters
    </a>

    <section class="pa-hero">
      <div class="pa-copy">
        <p class="pa-kicker">PRE-AXIS</p>
        <h1>
          what... <i>happened?</i>
        </h1>
        <p class="pa-lead">
          Before Axis's creation, I was practically studying my other forms that
          I could put myself in, like Axis himself for example. When making my
          earlier Minecraft skins (that's how most of my OCs originated, now I
          use Roblox cause I suck at pixel art) I had put my representation
          through many designs, including the <i>elusive</i> praxor cat that you
          may see all over the website.
        </p>
      </div>
      <figure class="pa-figure">
        <div
          class="pa-frame"
          role="button"
          tabindex="0"
          aria-haspopup="dialog"
          aria-label="View early design larger"
          data-art-index="0"
        >
          <span class="pa-corner tl" aria-hidden="true"></span>
          <span class="pa-corner tr" aria-hidden="true"></span>
          <span class="pa-corner bl" aria-hidden="true"></span>
          <span class="pa-corner br" aria-hidden="true"></span>
          <Image
            src={art.src}
            alt="Heian-era praxor design"
            width={art.width}
            height={art.height}
            loading="eager"
            decoding="async"
          />
        </div>
        <figcaption>
          {art.caption} <span>art by {art.artist}</span>
        </figcaption>
      </figure>
    </section>
  </main>
  <ImageGallery title="pre-axis" label="image" items={galleryItems} />
</Layout>

<style>
  /* Page styles: pre-axis */
  /* Page layout */
  .pa-main {
    box-sizing: border-box;
    flex: 0 0 auto;
    width: 100%;
    max-width: 1100px;
    margin: clamp(1.25rem, 3vw, 2.5rem) auto;
    padding: clamp(1.25rem, 3vw, 2.5rem);
    background:
      radial-gradient(ellipse at 85% 0%, var(--accent-12), transparent 45%),
      var(--card);
    border: 1px solid var(--muted-border);
    border-radius: 2px;
    box-shadow: inset 0 1px 0 var(--accent-12);
  }

  .pa-back {
    display: inline-block;
    margin-bottom: 1.5rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .pa-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(240px, 0.9fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: center;
  }

  /* Page typography */
  .pa-kicker {
    margin: 0 0 1rem;
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .pa-copy h1 {
    margin: 0 0 1.2rem;
    color: var(--text);
    font-size: clamp(3rem, 8vw, 5.5rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-transform: lowercase;
  }

  .pa-copy h1 span {
    color: var(--accent);
  }

  .pa-lead {
    max-width: 46ch;
    margin: 0;
    color: var(--muted);
    line-height: 1.8;
    overflow-wrap: anywhere;
  }

  /* Artwork and caption */
  .pa-figure {
    min-width: 0;
    margin: 0;
  }

  .pa-frame {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    padding: 14px;
    background: var(--accent-10);
    cursor: zoom-in;
    transform: rotate(1.5deg);
    transition: transform 0.25s ease;
  }

  .pa-frame:hover,
  .pa-frame:focus-visible {
    transform: rotate(0);
  }

  .pa-frame:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .pa-frame img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .pa-corner {
    position: absolute;
    width: 18px;
    height: 18px;
    border: 2px solid var(--accent);
    pointer-events: none;
  }

  .pa-corner.tl {
    top: 0;
    left: 0;
    border-right: 0;
    border-bottom: 0;
  }

  .pa-corner.tr {
    top: 0;
    right: 0;
    border-left: 0;
    border-bottom: 0;
  }

  .pa-corner.bl {
    bottom: 0;
    left: 0;
    border-right: 0;
    border-top: 0;
  }

  .pa-corner.br {
    right: 0;
    bottom: 0;
    border-left: 0;
    border-top: 0;
  }

  .pa-figure figcaption {
    margin-top: 0.9rem;
    color: var(--muted);
    font-size: 0.9rem;
    font-style: italic;
    text-align: center;
  }

  .pa-figure figcaption span {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.72rem;
    font-style: normal;
    opacity: 0.8;
  }

  /* Responsive layout */
  @media (max-width: 760px) {
    .pa-main {
      margin: 1rem 12px;
      padding: 1rem 12px;
    }

    .pa-hero {
      grid-template-columns: 1fr;
    }

    .pa-frame {
      transform: none;
    }
  }

  /* Accessibility: respect reduced-motion preferences */
  @media (prefers-reduced-motion: reduce) {
    .pa-frame {
      transition: none;
    }
  }
</style>
