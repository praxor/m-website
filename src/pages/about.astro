            <a href="https://www.youtube.com/@realpraxor" target="_blank" rel="noopener" aria-label="YouTube" title="open praxor on youtube" class="social-btn">
              <svg role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <title>youtube</title>
