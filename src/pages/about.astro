---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import { fanartOptions } from "../data/fanart";
import ImageGallery from "../components/ImageGallery.astro";
import Icon from "../components/Icon.astro";
const galleryItems = fanartOptions.map((art) => ({
  src: art.src,
  alt: `Fanart piece ${art.number} by ${art.artist}`,
  width: art.width,
  height: art.height,
  caption: art.caption,
  credit: art.artist,
}));
---

<Layout title="about" description="learn more about buddy ol' praxor.">
  <main class="wrap about-wrap">
    <section class="card about-card">
      <div class="about-intro">
        <div class="about-copy">
          <p class="about-kicker">ABOUT ME</p>
          <h1>
            hey, i'm
            <br />
            <span>praxor.</span>
          </h1>
          <p class="about-description">
            the myth, the legend. i often larp as the TV-head guy or the little
            black kitty. why? i have no idea, however i also enjoy coding and
            making music, which i'm sure both the characters would do in their
            spare times anyways.
          </p>
        </div>

        <div
          class="fanart-column-window"
          data-fanart-column
          role="region"
          aria-label="Fanart gallery"
        >
          <div class="fanart-strip-track" data-fanart-track>
            <div class="fanart-strip-set" data-fanart-set>
              {fanartOptions.map((art, index) => (
                <figure
                  class="fanart-strip-item"
                  role="button"
                  tabindex="0"
                  aria-haspopup="dialog"
                  aria-label={`Open fanart by ${art.artist}`}
                  data-art-index={index}
                  data-art-width={art.width}
                  data-art-height={art.height}
                >
                  <div
                    class="fanart-strip-art"
                    style={`--art-ratio: ${art.width} / ${art.height}`}
                  >
                    <template data-fanart-image>
                      <Image
                        src={art.src}
                        alt={`Fanart piece ${art.number}`}
                        width={art.width}
                        height={art.height}
                        loading="eager"
                        decoding="async"
                        fetchpriority="low"
                      />
                    </template>
                    <figcaption>{art.artist}</figcaption>
                  </div>
                </figure>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div class="about-bottom">
        <div class="social-block">
          <div class="social-heading">
            <span class="social-label">find me around</span>
            <span class="social-rule" aria-hidden="true"></span>
          </div>
          <p class="social-description">
            you can find more of my socials here:
          </p>
          <div class="socials">
            <a
              href="https://open.spotify.com/artist/5qjpeOAlOrY6kilCDZzYoz"
              target="_blank"
              rel="noopener"
              aria-label="Spotify"
              title="open praxor on spotify"
              class="social-btn"
            >
              <Icon name="brand-spotify" role="img" aria-label="spotify" />
            </a>

            <a
              href="https://soundcloud.com/praxor"
              target="_blank"
              rel="noopener"
              aria-label="SoundCloud"
              title="open praxor on soundcloud"
              class="social-btn"
            >
              <Icon name="brand-soundcloud" role="img" aria-label="soundcloud" />
            </a>

            <a
              href="https://www.youtube.com/@realpraxor"
              target="_blank"
              rel="noopener"
              aria-label="YouTube"
              title="open praxor on youtube"
              class="social-btn"
            >
              <Icon name="brand-youtube" role="img" aria-label="youtube" />
            </a>

            <a
              href="https://x.com/praxorf"
              target="_blank"
              rel="noopener"
              aria-label="Twitter"
              title="open praxor on x"
              class="social-btn"
            >
              <Icon name="brand-x" role="img" aria-label="x" />
            </a>
          </div>
        </div>
        <div class="version-actions">
          <p class="site-version">The Praxor Website, version 9.3.0</p>
          <button class="credits-launch" type="button" data-credits-launch>
            Credits
          </button>
        </div>
        <dialog
          class="credits-confirm"
          data-credits-confirm
          aria-labelledby="credits-confirm-title"
          aria-describedby="credits-confirm-copy"
        >
          <h2 id="credits-confirm-title">Ready to watch the credits show?</h2>
          <p id="credits-confirm-copy">
            The credits will begin scrolling across the screen.
          </p>
          <div class="credits-confirm-actions">
            <button type="button" data-credits-cancel>
              Cancel
            </button>
            <button type="button" data-credits-start>
              Start credits
            </button>
          </div>
        </dialog>
      </div>
    </section>
    <ImageGallery title="fanart" label="artwork" items={galleryItems} />
  </main>
</Layout>

<style>
  /* Page styles: about */
  .about-wrap {
    align-items: flex-start;
    padding-top: clamp(2rem, 6vw, 5rem);
    padding-bottom: 3rem;
  }

  .about-card {
    width: min(100%, 1120px);
    max-width: 1120px;
    padding: clamp(1.25rem, 4vw, 3.5rem);
    overflow: hidden;
    background:
      radial-gradient(
        ellipse at 82% 16%,
        color-mix(in srgb, var(--accent-2, var(--accent)) 14%, transparent),
        transparent 34%
      ),
      linear-gradient(
        145deg,
        var(--card),
        color-mix(in srgb, var(--card) 88%, var(--bg))
      );
    border-color: var(--muted-border);
    box-shadow:
      0 24px 80px var(--shadow-soft),
      inset 0 1px 0 var(--accent-12);
  }

  .about-intro {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(340px, 1.08fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
    min-height: 400px;
  }

  .about-copy {
    max-width: 470px;
  }
  .about-kicker,
  .social-label {
    margin: 0 0 1.2rem;
    color: var(--accent);
    font:
      600 0.72rem/1.2 "IBM Plex Sans",
      sans-serif;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .about-copy h1 {
    margin: 0 0 0.85rem;
    color: var(--text);
    font-size: clamp(3.6rem, 7vw, 6.2rem);
    font-weight: 700;
    line-height: 0.96;
  }

  .about-copy h1 span {
    color: var(--accent);
  }

  .about-description {
    max-width: 420px;
    margin: 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.8;
  }

  .fanart-column-window {
    position: relative;
    width: 100%;
    height: 400px;
    overflow: hidden;
  }

  .fanart-strip-track {
    width: 100%;
    height: 100%;
  }
  .fanart-strip-set {
    display: grid;
    grid-template-columns: repeat(var(--fanart-columns, 3), minmax(0, 1fr));
    align-items: start;
    gap: 4px;
    width: 100%;
    height: 100%;
  }
  .fanart-strip-column {
    position: relative;
    min-width: 0;
    height: 100%;
    overflow: hidden;
  }
  .fanart-column-loop {
    position: absolute;
    inset: 0 auto auto 0;
    display: flex;
    width: 100%;
    flex-direction: column;
    animation: fanart-scroll-up var(--fanart-loop-duration) linear infinite;
  }
  .fanart-column-loop:hover,
  .fanart-column-loop:focus-within {
    animation-play-state: paused;
  }
  .fanart-column-loop-set {
    display: flex;
    width: 100%;
    flex: none;
    flex-direction: column;
    gap: 4px;
  }
  .fanart-strip-item {
    display: block;
    min-width: 0;
    width: 100%;
    margin: 0;
  }

  .fanart-strip-art {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: var(--art-ratio);
  }

  .fanart-strip-item img {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    outline: 1px solid var(--art-border-color, #b6a5e8);
    outline-offset: -1px;
    object-fit: contain;
    transition: filter 0.18s ease;
  }

  .fanart-strip-item figcaption {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    overflow: hidden;
    padding: 0.45rem;
    color: var(--on-image);
    background: color-mix(in srgb, var(--image-scrim) 55%, transparent);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.35;
    text-align: center;
    text-shadow: 0 1px 4px var(--image-scrim);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.18s ease;
  }

  .fanart-strip-item:hover img,
  .fanart-strip-item:focus-visible img {
    filter: brightness(0.42);
  }
  .fanart-strip-item:hover figcaption,
  .fanart-strip-item:focus-visible figcaption {
    opacity: 1;
  }
  .fanart-strip-item:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  @keyframes fanart-scroll-up {
    to {
      transform: translateY(calc(-50% - 2px));
    }
  }

  .fanart-strip-item[role="button"] {
    cursor: zoom-in;
  }

  .about-bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    margin-top: 1.75rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--muted-border);
  }

  .social-heading {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }
  .social-heading .social-label {
    margin: 0;
  }
  .social-rule {
    width: 2rem;
    height: 1px;
    background: color-mix(in srgb, var(--accent) 35%, transparent);
  }
  .social-description {
    margin: 0.4rem 0 0;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .about-bottom .socials {
    justify-content: flex-start;
    width: fit-content;
    margin-top: 0.55rem;
    padding: 0;
    background: transparent;
  }
  .about-bottom .social-btn {
    color: var(--text);
  }

  .site-version {
    margin: 0;
    color: var(--muted);
    font-family:
      "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
    font-size: 0.72rem;
  }

  .version-actions {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-wrap: wrap;
  }
  .credits-launch {
    padding: 3px 7px;
    border: 1px solid var(--muted-border);
    border-radius: 4px;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 0.68rem;
    cursor: pointer;
  }
  .credits-launch:hover,
  .credits-launch:focus-visible {
    border-color: var(--accent);
    color: var(--text);
  }
  .credits-confirm {
    box-sizing: border-box;
    width: min(340px, calc(100vw - 32px));
    padding: 20px;
    border: 1px solid var(--muted-border);
    border-radius: 6px;
    background: var(--card);
    color: var(--text);
    box-shadow: 0 18px 56px var(--shadow-strong);
  }
  .credits-confirm::backdrop {
    background: rgba(0, 0, 0, 0.68);
    backdrop-filter: blur(2px);
  }
  .credits-confirm h2 {
    margin: 0;
    color: var(--text);
    font-size: 1rem;
    line-height: 1.4;
  }
  .credits-confirm > p {
    margin: 9px 0 18px;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.5;
  }
  .credits-confirm-actions {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
  }
  .credits-confirm-actions button {
    padding: 7px 11px;
    border: 1px solid var(--muted-border);
    border-radius: 4px;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 0.78rem;
    cursor: pointer;
  }
  .credits-confirm-actions button:last-child {
    border-color: var(--accent);
    color: var(--accent);
  }
  .credits-confirm-actions button:hover,
  .credits-confirm-actions button:focus-visible {
    background: var(--accent-10);
    color: var(--text);
  }
  .credits-confirm-actions button:focus-visible,
  .credits-launch:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @media (max-width: 780px) {
    .about-intro {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .about-copy {
      max-width: none;
    }
    .about-copy h1 {
      font-size: clamp(3.4rem, 15vw, 5.5rem);
    }
    .fanart-column-window {
      height: 320px;
    }
    .fanart-strip-set {
      gap: 4px;
    }
    .about-bottom {
      align-items: flex-start;
      flex-direction: column;
      margin-top: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fanart-column-window {
      overflow-y: auto;
      mask-image: none;
    }
    .fanart-strip-set {
      height: auto;
    }
    .fanart-strip-column {
      height: auto;
      overflow: visible;
    }
    .fanart-column-loop {
      position: static;
      animation: none;
    }
    .fanart-column-loop-set[data-fanart-copy] {
      display: none;
    }
  }
</style>

<script>
  import { prefersReducedMotion } from "../scripts/site-state";

  let creditsConfirm: HTMLDialogElement | null = null;
  let creditsDialogAnimation: Animation | null = null;
  let creditsDialogAction: (() => void) | null = null;
  let creditsDialogCloseId = 0;
  const finishCreditsDialogClose = (closeId: number) => {
    if (closeId !== creditsDialogCloseId || !creditsConfirm?.open) return;
    creditsConfirm.close();
    creditsConfirm.classList.remove("is-closing");
    creditsDialogAnimation = null;
    const action = creditsDialogAction;
    creditsDialogAction = null;
    action?.();
  };
  const closeCreditsDialog = (action?: () => void) => {
    if (!creditsConfirm?.open) return action?.();
    creditsDialogAction = action ?? null;
    const closeId = ++creditsDialogCloseId;
    if (prefersReducedMotion()) return finishCreditsDialogClose(closeId);
    creditsConfirm.classList.add("is-closing");
    creditsDialogAnimation?.cancel();
    creditsDialogAnimation = creditsConfirm.animate(
      [
        { opacity: 1, transform: "translateY(0) scale(1)" },
        { opacity: 0, transform: "translateY(6px) scale(.985)" },
      ],
      { duration: 180, easing: "ease-in", fill: "forwards" },
    );
    void creditsDialogAnimation.finished.then(
      () => finishCreditsDialogClose(closeId),
      () => {},
    );
  };

  const initializeCreditsDialog = () => {
    const creditsLaunch = document.querySelector<HTMLButtonElement>(
      "[data-credits-launch]",
    );
    const dialog = document.querySelector<HTMLDialogElement>(
      "[data-credits-confirm]",
    );
    const creditsCancel = document.querySelector<HTMLButtonElement>(
      "[data-credits-cancel]",
    );
    const creditsStart = document.querySelector<HTMLButtonElement>(
      "[data-credits-start]",
    );
    if (!dialog || dialog.dataset.initialized === "true") return;
    dialog.dataset.initialized = "true";
    creditsConfirm = dialog;
    creditsDialogAnimation = null;
    creditsDialogAction = null;

    creditsLaunch?.addEventListener("click", () => {
      dialog.showModal();
      if (dialog.open && !prefersReducedMotion())
        dialog.animate(
          [
            { opacity: 0, transform: "translateY(6px) scale(.985)" },
            { opacity: 1, transform: "translateY(0) scale(1)" },
          ],
          { duration: 220, easing: "ease-out" },
        );
    });
    creditsCancel?.addEventListener("click", () => closeCreditsDialog());
    dialog.addEventListener("cancel", (event) => {
      event.preventDefault();
      closeCreditsDialog();
    });
    creditsStart?.addEventListener("click", () => {
      closeCreditsDialog(() =>
        window.location.assign(`${import.meta.env.BASE_URL}credits/`),
      );
    });
  };
  document.addEventListener("astro:page-load", initializeCreditsDialog);
  initializeCreditsDialog();

  const setBorderFromImage = (image: HTMLImageElement): void => {
    if (!image.complete || !image.naturalWidth) return;

    const canvas = document.createElement("canvas");
    canvas.width = 16;
    canvas.height = 16;
    const context = canvas.getContext("2d", { willReadFrequently: true });
    if (!context) return;

    context.drawImage(image, 0, 0, canvas.width, canvas.height);
    const pixels = context.getImageData(0, 0, canvas.width, canvas.height).data;
    const colors = new Map();

    for (let index = 0; index < pixels.length; index += 4) {
      if (pixels[index + 3] < 128) continue;

      const red = pixels[index];
      const green = pixels[index + 1];
      const blue = pixels[index + 2];
      const maximum = Math.max(red, green, blue);
      const minimum = Math.min(red, green, blue);
      const saturation = maximum === 0 ? 0 : (maximum - minimum) / maximum;
      const key = `${red >> 4}-${green >> 4}-${blue >> 4}`;
      const color = colors.get(key) ?? {
        count: 0,
        saturation: 0,
        red: 0,
        green: 0,
        blue: 0,
      };

      color.count += 1;
      color.saturation += saturation;
      color.red += red;
      color.green += green;
      color.blue += blue;
      colors.set(key, color);
    }

    const dominant = Array.from(colors.values()).sort((first, second) => {
      const firstScore =
        first.count * (1 + (first.saturation / first.count) * 1.4);
      const secondScore =
        second.count * (1 + (second.saturation / second.count) * 1.4);
      return secondScore - firstScore;
    })[0];

    if (!dominant) return;
    image.style.setProperty(
      "--art-border-color",
      `rgb(${Math.round(dominant.red / dominant.count)} ${Math.round(dominant.green / dominant.count)} ${Math.round(dominant.blue / dominant.count)})`,
    );
  };

  const setBorderWhenLoaded = (image: HTMLImageElement): void => {
    if (image.complete && image.naturalWidth) {
      setBorderFromImage(image);
    } else {
      image.addEventListener("load", () => setBorderFromImage(image), {
        once: true,
      });
    }
  };

  const fanartObservers = new WeakMap<HTMLElement, IntersectionObserver>();

  const initializeFanartColumn = (column: HTMLElement): void => {
    if (column.dataset.fanartInitializing === "true") return;

    const track = column.querySelector<HTMLDivElement>("[data-fanart-track]");
    const set = track?.querySelector<HTMLDivElement>("[data-fanart-set]");
    if (!track || !set) return;

    column.dataset.fanartInitializing = "true";
    fanartObservers.get(column)?.disconnect();
    track
      .querySelectorAll("[data-fanart-copy]")
      .forEach((copy) => copy.remove());

    const pieces = Array.from(
      set.querySelectorAll<HTMLElement>(".fanart-strip-item"),
    ).filter((piece) => !piece.closest("[data-fanart-copy]"));
    if (!column.isConnected) return;

    if (column.dataset.fanartShuffled !== "true") {
      for (let index = pieces.length - 1; index > 0; index -= 1) {
        const swapIndex = Math.floor(Math.random() * (index + 1));
        [pieces[index], pieces[swapIndex]] = [pieces[swapIndex], pieces[index]];
      }

      column.dataset.fanartShuffled = "true";
    }

    const columns = window.matchMedia("(max-width: 780px)").matches ? 2 : 3;
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const artworkGap = 4;
    const setStyle = getComputedStyle(set);
    const columnGap = Number.parseFloat(setStyle.columnGap);
    const columnWidth =
      (set.getBoundingClientRect().width - columnGap * (columns - 1)) / columns;
    const columnHeights = new Array<number>(columns).fill(0);
    const stripColumns = Array.from({ length: columns }, () => {
      const stripColumn = document.createElement("div");
      stripColumn.className = "fanart-strip-column";
      stripColumn.style.position = "relative";
      stripColumn.style.minWidth = "0";
      stripColumn.style.height = prefersReducedMotion ? "auto" : "100%";
      stripColumn.style.overflow = prefersReducedMotion ? "visible" : "hidden";
      return stripColumn;
    });
    const columnItems: HTMLElement[][] = Array.from(
      { length: columns },
      () => [],
    );

    set.style.setProperty("--fanart-columns", String(columns));
    pieces.forEach((piece) => {
      const image = piece.querySelector<HTMLImageElement>("img");
      piece.style.gridColumn = "";
      const columnIndex = columnHeights.indexOf(Math.min(...columnHeights));
      const width = Number(piece.dataset.artWidth);
      const height = Number(piece.dataset.artHeight);
      if (columnItems[columnIndex].length > 0)
        columnHeights[columnIndex] += artworkGap;
      columnItems[columnIndex].push(piece);
      columnHeights[columnIndex] += columnWidth * (height / width);
    });

    stripColumns.forEach((stripColumn, index) => {
      const loop = document.createElement("div");
      loop.className = "fanart-column-loop";
      loop.style.position = prefersReducedMotion ? "static" : "absolute";
      loop.style.inset = "0 auto auto 0";
      loop.style.display = "flex";
      loop.style.width = "100%";
      loop.style.flexDirection = "column";
      loop.style.gap = `${artworkGap}px`;
      loop.style.animation = prefersReducedMotion
        ? "none"
        : `fanart-scroll-up ${Math.max(12, (columnHeights[index] + artworkGap) / 32)}s linear infinite`;

      const sourceSet = document.createElement("div");
      sourceSet.className = "fanart-column-loop-set";
      sourceSet.style.display = "flex";
      sourceSet.style.width = "100%";
      sourceSet.style.flexDirection = "column";
      sourceSet.style.gap = `${artworkGap}px`;
      sourceSet.append(...columnItems[index]);

      const copy = sourceSet.cloneNode(true) as HTMLDivElement;
      copy.setAttribute("data-fanart-copy", "");
      copy.setAttribute("aria-hidden", "true");
      if (prefersReducedMotion) copy.style.display = "none";
      copy
        .querySelectorAll<HTMLElement>(".fanart-strip-item")
        .forEach((item) => {
          item.setAttribute("tabindex", "-1");
        });

      loop.append(sourceSet, copy);
      stripColumn.append(loop);

      if (!prefersReducedMotion) {
        const pauseLoop = () => {
          loop.style.animationPlayState = "paused";
        };
        const resumeLoop = () => {
          if (!loop.contains(document.activeElement))
            loop.style.animationPlayState = "running";
        };
        loop.addEventListener("pointerenter", pauseLoop);
        loop.addEventListener("pointerleave", resumeLoop);
        loop.addEventListener("focusin", pauseLoop);
        loop.addEventListener("focusout", resumeLoop);
      }
    });

    set.replaceChildren(...stripColumns);

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          const item = entry.target as HTMLElement;
          const frame = item.querySelector<HTMLDivElement>(".fanart-strip-art");
          if (!frame || frame.querySelector("img")) {
            observer.unobserve(item);
            return;
          }
          const template = frame?.querySelector<HTMLTemplateElement>(
            "[data-fanart-image]",
          );
          const sourceImage =
            template?.content.querySelector<HTMLImageElement>("img");
          if (!template || !sourceImage) {
            observer.unobserve(item);
            return;
          }

          const image = sourceImage.cloneNode(true) as HTMLImageElement;
          frame.insertBefore(image, template);
          template.remove();
          setBorderWhenLoaded(image);
          observer.unobserve(item);
        });
      },
      { root: column, rootMargin: "120px 0px" },
    );

    track
      .querySelectorAll<HTMLElement>(".fanart-strip-item")
      .forEach((item) => observer.observe(item));
    fanartObservers.set(column, observer);
    column.dataset.fanartInitializing = "false";
  };

  const initializeFanartColumns = () => {
    document
      .querySelectorAll<HTMLElement>("[data-fanart-column]")
      .forEach((column) => {
        void initializeFanartColumn(column);
      });
  };

  let fanartResizeTimer: number | undefined;
  let fanartLastWidth = window.innerWidth;
  window.addEventListener("resize", () => {
    // Scrolling on mobile fires height-only resizes (address bar); ignore them.
    if (window.innerWidth === fanartLastWidth) return;
    fanartLastWidth = window.innerWidth;
    if (fanartResizeTimer !== undefined) window.clearTimeout(fanartResizeTimer);
    fanartResizeTimer = window.setTimeout(initializeFanartColumns, 120);
  });

  document.addEventListener("astro:page-load", initializeFanartColumns);
  initializeFanartColumns();
</script>
