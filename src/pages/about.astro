            </div>
            <p class="site-version">The Praxor Website, version 9.0.1c</p>
          </div>
      </section>
    </main>
</Layout>

<style>
  .site-version {
    margin-top: 1rem;
    color: var(--muted);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-align: center;
    opacity: 0.82;
  }
</style>
