---
import Layout from '../layouts/Layout.astro';
---
<Layout title="about" description="learn more about buddy ol' praxor.">
    <main class="wrap">
      <section class="card">
        <div class="center-contents">
            <h1>about me</h1>
            <p class="lead">hey, i'm praxor.</p>
            <p>i often larp as a little black kitty because i like to be cute and mysterious sometimes. however, i also enjoy coding and making music. you can find more of my socials here:</p>

            <div class="socials">
            <a href="https://open.spotify.com/artist/5qjpeOAlOrY6kilCDZzYoz" target="_blank" rel="noopener" aria-label="Spotify" title="open praxor on spotify" class="social-btn">
