---
import Layout from '../../layouts/Layout.astro';
import HomeHero from '../../components/HomeHero.astro';
import HomeFrame from '../../components/HomeFrame.astro';
import PostTypeIcon from '../../components/PostTypeIcon.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const visiblePosts = await getCollection('posts', ({ data }) => !data.draft || !import.meta.env.PROD);
  const sortedPosts = visiblePosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  const latestByType = new Map<string, string>();
  sortedPosts.forEach((post) => {
    if (!latestByType.has(post.data.type)) latestByType.set(post.data.type, post.id);
  });
  return sortedPosts.map((post) => ({
    params: { id: post.id },
    props: { post, isLatest: latestByType.get(post.data.type) === post.id },
  }));
}

const { post, isLatest } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL;
const formatDate = (date: Date) => new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
}).format(date);
const typeLabel = post.data.type === 'update' ? 'UPDATE' : 'POST';
const imageSrc = post.data.image
  ? (/^(https?:|data:)/.test(post.data.image) ? post.data.image : `${base}${post.data.image.replace(/^\/+/, '')}`)
  : undefined;
---

<Layout title={post.data.title} description={post.data.description || 'a post from the praxor website.'}>
  <main class="home-page">
    <HomeHero />
    <HomeFrame>
      <section class="dispatch-feed update-reader" slot="feed" aria-labelledby="update-title">
        <a class="update-back" href={`${base}#dispatch-title`}>back to recent updates</a>
        <article class:list={['update-article', { 'is-latest': isLatest }]}>
          <header class="update-header">
            <p class="update-kind">{isLatest ? 'NEW ' : ''}{typeLabel}</p>
            <h2 id="update-title">{post.data.title}</h2>
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          </header>
          <div class="update-divider" aria-hidden="true"></div>
          {imageSrc && <figure class="update-cover"><img src={imageSrc} alt={post.data.imageAlt || post.data.title} loading="eager" decoding="async" /></figure>}
          {post.data.description && <p class="update-description">{post.data.description}</p>}
          <div class="update-divider markdown-divider" aria-hidden="true"></div>
          <div class="update-body"><Content /></div>
          <footer class="update-footer">
            <span class="post-kind-icon" aria-hidden="true"><PostTypeIcon type={post.data.type} /></span>
            <span>{typeLabel}</span>
          </footer>
        </article>
      </section>
    </HomeFrame>
  </main>
</Layout>

<script>
  const resetPostScroll = () => {
    if (document.querySelector('.update-reader')) window.scrollTo({ top: 0, left: 0, behavior: 'auto' });
  };
  document.addEventListener('astro:page-load', resetPostScroll);
  resetPostScroll();
</script>

<style>
  .home-page{box-sizing:border-box;width:min(1100px,calc(100% - 32px));margin:0 auto;padding-bottom:132px}
  .update-reader{padding-top:12px}
  .update-back{display:inline-block;margin:0 0 14px;color:var(--muted);font-size:.76rem;text-decoration:none}
  .update-back:hover,.update-back:focus-visible{color:var(--text);text-decoration:underline;text-underline-offset:3px}
  .update-article{position:relative;min-width:0;padding-bottom:24px}
  .update-article.is-latest{box-shadow:inset 2px 0 0 var(--accent);padding-left:12px}
  .update-header{position:relative;max-width:100%}
  .update-kind{margin:0 0 10px;color:var(--accent);font-size:.7rem;font-weight:700;letter-spacing:.12em}
  .update-header h2{margin:0;color:var(--text);font-size:clamp(1.35rem,3vw,2rem);line-height:1.15;letter-spacing:0;overflow-wrap:anywhere}
  .update-header time{display:block;margin-top:10px;color:var(--muted);font-size:.76rem}
  .update-divider{width:34px;height:2px;margin:18px 0;background:var(--accent)}
  .update-cover{display:grid;place-items:center;min-height:100px;max-height:min(58vh,560px);margin:0 0 13px;overflow:hidden;background:rgba(0,0,0,.18)}
  .update-cover img{display:block;width:100%;height:auto;max-height:min(58vh,560px);object-fit:contain}
  .update-description{margin:0;color:var(--muted);font-size:.87rem;line-height:1.6}
  .markdown-divider{margin:20px 0}
  .update-body{min-width:0;color:var(--text);font-size:.93rem;line-height:1.75;overflow-wrap:anywhere}
  .update-body :global(p){margin:0 0 14px}
  .update-body :global(p:last-child){margin-bottom:0}
  .update-body :global(h2),.update-body :global(h3){margin:24px 0 10px;color:var(--text);line-height:1.3;letter-spacing:0}
  .update-body :global(a){color:var(--accent);text-decoration:underline;text-underline-offset:2px}
  .update-body :global(ul),.update-body :global(ol){padding-left:1.3rem}
  .update-body :global(img){display:block;width:auto;height:auto;max-width:100%;max-height:min(72vh,720px);margin:20px auto;object-fit:contain}
  .update-body :global(figure){max-width:100%;margin:20px 0}
  .update-body :global(pre){box-sizing:border-box;max-width:100%;overflow-x:auto;margin:18px 0;padding:14px;border:1px solid var(--muted-border);background:#08060d;color:var(--text);font-family:"SFMono-Regular",Consolas,"Liberation Mono",Menlo,monospace;font-size:.8rem;line-height:1.6;white-space:pre}
  .update-body :global(pre code){padding:0;background:transparent;color:inherit;font-size:inherit;white-space:pre}
  .update-body :global(:not(pre) > code){padding:2px 4px;background:rgba(0,0,0,.24);font-size:.86em}
  .update-body :global(blockquote){margin:16px 0;padding-left:14px;border-left:2px solid var(--accent);color:var(--muted)}
  .update-body :global(table){display:block;max-width:100%;overflow-x:auto;border-collapse:collapse}
  .update-body :global(th),.update-body :global(td){padding:7px 10px;border:1px solid var(--muted-border);text-align:left}
  .update-footer{display:flex;align-items:center;gap:8px;margin-top:28px;padding-top:14px;border-top:1px solid var(--muted-border);color:var(--muted);font-size:.7rem;letter-spacing:.08em}
  .update-footer .post-kind-icon{display:grid;place-items:center;width:26px;height:26px;border:1px solid var(--muted-border);color:var(--accent)}
  @media(max-width:600px){.update-reader{padding-top:12px}.update-cover{min-height:60px}.update-footer{margin-top:20px}}
</style>