---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>art</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,100..700;1,100..700&display=swap" rel="stylesheet">
  </head>
  <body>
    <Header />
    <main class="wrap">
      <section class="card">
        <div class="center-contents">
          <h1>art</h1>
          <p class="lead">all of my fanarts collected throughout some time. thank you to those who've supported me.</p>
          <br>
        </div>
        <ArtGrid items={items} />
      </section>
    </main>
  </body>
</html>
