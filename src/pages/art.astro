---
import '../styles/global.css';
import Header from '../components/Header.astro';
import ArtGrid from '../components/ArtGrid.astro';

const items = [
  { src: 'https://praxor.de/media/fanart1.png', title: 'toohi' },
  { src: 'https://praxor.de/media/fanart2.jpeg', title: 'blueistic' },
  { src: 'https://praxor.de/media/fanart3.png', title: 'fyre' },
  { src: 'https://praxor.de/media/fanart4.png', title: 'louies' },
  { src: 'https://praxor.de/media/fanart5.png', title: 'toohi' },
  { src: 'https://praxor.de/media/fanart6.png', title: 'toohi' },
  { src: 'https://praxor.de/media/fanart7.png', title: 'toohi' },
  { src: 'https://praxor.de/media/fanart8.png', title: '???' },
  { src: 'https://praxor.de/media/fanart9.png', title: 'toohi' },
  { src: 'https://praxor.de/media/fanart10.png', title: 'can you guess who did it' },
  { src: 'https://praxor.de/media/fanart11.png', title: 'lego_foxy' },
  { src: 'https://praxor.de/media/fanart12.png', title: 'lotterytickett' },
