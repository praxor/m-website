<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>surprise</title>
    <style>
      :root{background:#000;color:#777;font-family:"Roboto Mono",monospace}
      html,body{width:100%;height:100%;margin:0;background:#000}
      body{display:grid;place-items:center}
      main{display:flex;flex-direction:column;align-items:center;gap:1.25rem;padding:24px;text-align:center}
      .surprise-label{margin:0;color:transparent;background:linear-gradient(90deg,#3d172f,#3b244b,#173b45,#3e3b19,#432126);background-clip:text;-webkit-background-clip:text;font:inherit;font-size:.75rem;letter-spacing:.08em}
      img{display:block;width:min(78vw,720px);height:auto;max-height:72vh;object-fit:contain}
      a{color:#777;font:inherit;font-size:.7rem;text-decoration:none}
      a:hover,a:focus-visible{color:#aaa;text-decoration:underline}
    </style>
  </head>
  <body>
    <main>
      <p class="surprise-label">i love and hate you all, from the bottom of my heart.</p>
      <img src="/media/res/jumbos.png" alt="frienemies" />
      <a href="/">go back home</a>
    </main>
  </body>
</html>
